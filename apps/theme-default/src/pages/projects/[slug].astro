---
import ProjectPage from "../../components/ProjectPage.astro";
import { loadPortfolio } from "@japs/theme-kit";

export function getStaticPaths() {
  const portfolio = loadPortfolio();
  return portfolio.projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
---

<ProjectPage project={project} locale={loadPortfolio().defaultLocale} />
