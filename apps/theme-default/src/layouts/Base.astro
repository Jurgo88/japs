---
import ThemeToggle from "../components/ThemeToggle.astro";
import { languageName, t } from "../lib/i18n.ts";

interface Props {
  locale: string;
  title: string;
  description: string;
  /** The same page in every locale, for the switcher and hreflang. */
  alternates: { locale: string; href: string }[];
  homeHref: string;
  name: string;
}

const { locale, title, description, alternates, homeHref, name } = Astro.props;
const site = Astro.site;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {
      site &&
        alternates.map((a) => <link rel="alternate" hreflang={a.locale} href={new URL(a.href, site).toString()} />)
    }
    <link
      rel="icon"
      href={`data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='8' fill='%23111827'/><text x='16' y='22' font-family='system-ui' font-size='16' font-weight='700' fill='white' text-anchor='middle'>${encodeURIComponent(name.trim().charAt(0).toUpperCase())}</text></svg>`}
    />
    <!-- Apply the stored light/dark choice before first paint (ThemeToggle writes it). -->
    <script is:inline>
      try {
        const theme = localStorage.getItem("japs-theme");
        if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href={homeHref}>{name}</a>
        <div class="header-tools">
          {
            alternates.length > 1 && (
              <nav class="langs" aria-label={t(locale, "language")}>
                {alternates.map((a) => (
                  <a href={a.href} hreflang={a.locale} aria-current={a.locale === locale ? "true" : undefined}>
                    {languageName(a.locale)}
                  </a>
                ))}
              </nav>
            )
          }
          <ThemeToggle locale={locale} />
        </div>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="wrap site-footer">
      <span>© {new Date().getFullYear()} {name}</span>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #ffffff;
    --surface: #f6f7f9;
    --text: #111827;
    --muted: #5b6474;
    --border: #e5e7eb;
    --accent: #2563eb;
    --on-accent: #ffffff;
    --accent-2: #9333ea;
    --frame: #e9ecf1;
    --shadow: 0 18px 40px -18px rgb(15 23 42 / 0.28);
    --radius: 14px;
    --ease-out: cubic-bezier(0.2, 0.7, 0.2, 1);
    color-scheme: light dark;
  }
  /* Dark tokens twice: for the system setting (unless the visitor chose light) and for an explicit choice. */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #0d1117;
      --surface: #161b22;
      --text: #e6edf3;
      --muted: #9aa4b2;
      --border: #2a313c;
      --accent: #6ea8fe;
      --on-accent: #0d1117;
      --accent-2: #c084fc;
      --frame: #1f2630;
      --shadow: 0 18px 40px -18px rgb(0 0 0 / 0.7);
    }
  }
  :root[data-theme="dark"] {
    --bg: #0d1117;
    --surface: #161b22;
    --text: #e6edf3;
    --muted: #9aa4b2;
    --border: #2a313c;
    --accent: #6ea8fe;
    --on-accent: #0d1117;
    --accent-2: #c084fc;
    --frame: #1f2630;
    --shadow: 0 18px 40px -18px rgb(0 0 0 / 0.7);
    color-scheme: dark;
  }
  :root[data-theme="light"] {
    color-scheme: light;
  }

  /* Card → detail morph between pages (browsers without support just navigate). */
  @media (prefers-reduced-motion: no-preference) {
    @view-transition {
      navigation: auto;
    }
    ::view-transition-group(*) {
      animation-duration: 0.38s;
      animation-timing-function: var(--ease-out);
    }
  }

  * {
    box-sizing: border-box;
  }
  [hidden] {
    display: none !important;
  }
  html {
    -webkit-text-size-adjust: 100%;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 16px/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    /* Decorative gradients may reach past the edge; never scroll sideways. */
    overflow-x: clip;
  }
  a {
    color: var(--accent);
  }
  img {
    max-width: 100%;
    display: block;
  }
  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .wrap {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 16px;
  }
  .site-header {
    border-bottom: 1px solid var(--border);
    /* Stays put while the page content morphs. */
    view-transition-name: site-header;
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 60px;
  }
  .header-tools {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .brand {
    color: var(--text);
    font-weight: 700;
    text-decoration: none;
  }
  .langs {
    display: flex;
    gap: 12px;
    font-size: 14px;
  }
  .langs a {
    color: var(--muted);
    text-decoration: none;
  }
  .langs a[aria-current="true"] {
    color: var(--text);
    font-weight: 600;
  }
  .site-footer {
    color: var(--muted);
    font-size: 14px;
    padding-top: 48px;
    padding-bottom: 32px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .tags li {
    font-size: 12px;
    padding: 2px 10px;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
  }
  .badge {
    display: inline-block;
    font-size: 12px;
    font-weight: 600;
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--surface);
    color: var(--muted);
  }
</style>
