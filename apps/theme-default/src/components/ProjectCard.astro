---
import type { Portfolio, PortfolioProject } from "@japs/schema";
import { coverShot, formatMonth, projectUrl, t, text, transitionName } from "@japs/theme-kit";

interface Props {
  project: PortfolioProject;
  portfolio: Portfolio;
  locale: string;
}

const { project, portfolio, locale } = Astro.props;
const shot = coverShot(project);
const year = formatMonth(project.period.to ?? project.period.from, locale);
---

<article
  class:list={["card", { featured: project.featured }]}
  data-tags={project.tags.map((tag) => tag.toLowerCase()).join("|")}
  data-card={transitionName("card", project)}
>
  <div class="cover">
    {
      shot ? (
        <img
          src={`/${shot.src}`}
          alt=""
          loading="lazy"
          width={shot.viewport === "mobile" ? 390 : 1440}
          height={shot.viewport === "mobile" ? 844 : 900}
          style={`view-transition-name: ${transitionName("shot", project)}`}
        />
      ) : (
        <span class="placeholder">{text(project.title, locale).charAt(0)}</span>
      )
    }
  </div>
  <div class="body">
    <div class="meta">
      {project.featured && <span class="badge">{t(locale, "featured")}</span>}
      {project.client.isClient && <span class="badge">{t(locale, "clientWork")}</span>}
      {year && <span class="year">{year}</span>}
    </div>
    <h3 style={`view-transition-name: ${transitionName("title", project)}`}>
      <a href={projectUrl(project, locale, portfolio)}>{text(project.title, locale)}</a>
    </h3>
    <p>{text(project.summary, locale)}</p>
    <ul class="tags">
      {project.tags.slice(0, 5).map((tag) => <li>{tag}</li>)}
    </ul>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg);
    transition:
      transform 0.25s var(--ease-out),
      box-shadow 0.25s var(--ease-out),
      border-color 0.25s;
  }
  .card:hover,
  .card:focus-within {
    border-color: color-mix(in srgb, var(--accent) 35%, var(--border));
    box-shadow: var(--shadow);
  }
  .card:has(h3 a:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .cover {
    aspect-ratio: 16 / 10;
    background: var(--surface);
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 0.5s var(--ease-out);
  }
  .placeholder {
    font-size: 48px;
    font-weight: 700;
    color: var(--muted);
  }
  .body {
    padding: 16px 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }
  .meta {
    display: flex;
    gap: 8px;
    align-items: center;
    min-height: 22px;
  }
  .year {
    font-size: 13px;
    color: var(--muted);
    margin-left: auto;
  }
  h3 {
    margin: 0;
    font-size: 18px;
    line-height: 1.3;
    width: fit-content;
    max-width: 100%;
  }
  h3 a {
    color: var(--text);
    text-decoration: none;
  }
  /* The title link covers the whole card. */
  h3 a::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  h3 a:focus-visible {
    outline: none;
  }
  h3 a::after {
    content: "→";
    display: inline-block;
    margin-left: 6px;
    color: var(--accent);
    opacity: 0;
    transform: translateX(-6px);
    transition:
      opacity 0.2s,
      transform 0.25s var(--ease-out);
  }
  .card:hover h3 a::after,
  .card:focus-within h3 a::after {
    opacity: 1;
    transform: none;
  }
  p {
    margin: 0 0 4px;
    color: var(--muted);
    font-size: 15px;
    flex: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .card:hover,
    .card:focus-within {
      transform: translateY(-4px);
    }
    .card:hover .cover img {
      transform: scale(1.04);
    }
    /* Cards fade up as they scroll into view; ones already on screen at load are fully shown. */
    @supports (animation-timeline: view()) {
      .card {
        animation: card-in linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 60%;
      }
    }
  }
  @keyframes card-in {
    from {
      opacity: 0;
      translate: 0 32px;
      scale: 0.97;
    }
  }
</style>
