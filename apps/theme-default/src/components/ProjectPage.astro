---
import type { PortfolioProject } from "@japs/schema";
import {
  coverShot,
  formatMonth,
  loadPortfolio,
  localePrefix,
  neighbours,
  projectUrl,
  renderMarkdown,
  t,
  text,
  transitionName,
} from "@japs/theme-kit";
import Base from "../layouts/Base.astro";

interface Props {
  project: PortfolioProject;
  locale: string;
}

const { project, locale } = Astro.props;
const portfolio = loadPortfolio();
const title = text(project.title, locale);
const from = formatMonth(project.period.from, locale);
const to = formatMonth(project.period.to, locale) ?? t(locale, "present");
const period = from ? `${from} – ${to}` : to;
const role = project.role ? text(project.role, locale) : null;
const clientLabel = project.client.label ? text(project.client.label, locale) : null;
const desktop = project.screenshots.find((s) => s.viewport === "desktop");
const mobile = project.screenshots.find((s) => s.viewport === "mobile");
const cover = coverShot(project);
// The card's screenshot morphs into the same one here.
const shotStyle = (shot: typeof cover) =>
  shot === cover ? `view-transition-name: ${transitionName("shot", project)}` : undefined;
const host = project.links.live ? new URL(project.links.live).host : null;
const { previous, next } = neighbours(project, portfolio);
const pager = [
  previous && { project: previous, label: t(locale, "previous"), rel: "prev" },
  next && { project: next, label: t(locale, "next"), rel: "next" },
].filter((item) => !!item);
---

<Base
  locale={locale}
  title={`${title} — ${portfolio.profile.name}`}
  description={text(project.summary, locale)}
  alternates={portfolio.locales.map((l) => ({ locale: l, href: projectUrl(project, l, portfolio) }))}
  homeHref={`${localePrefix(locale, portfolio)}/`}
  name={portfolio.profile.name}
>
  <article class="project">
    <a class="back" href={`${localePrefix(locale, portfolio)}/`}>← {t(locale, "back")}</a>
    <h1 style={`view-transition-name: ${transitionName("title", project)}`}>{title}</h1>
    <p class="summary">{text(project.summary, locale)}</p>
    {(project.client.isClient || clientLabel) && <p class="badge">{clientLabel ?? t(locale, "clientWork")}</p>}

    <dl class="facts">
      {
        role && (
          <div>
            <dt>{t(locale, "role")}</dt>
            <dd>{role}</dd>
          </div>
        )
      }
      <div>
        <dt>{t(locale, "period")}</dt>
        <dd>{period}</dd>
      </div>
      {
        project.tags.length > 0 && (
          <div>
            <dt>{t(locale, "stack")}</dt>
            <dd>
              <ul class="tags">
                {project.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
            </dd>
          </div>
        )
      }
    </dl>

    {
      (project.links.live || project.links.repo) && (
        <p class="actions">
          {project.links.live && (
            <a class="button" href={project.links.live} rel="noopener">
              {t(locale, "live")} ↗
            </a>
          )}
          {project.links.repo && (
            <a class="button secondary" href={project.links.repo} rel="noopener">
              {t(locale, "source")} ↗
            </a>
          )}
        </p>
      )
    }

    {
      (desktop || mobile) && (
        <div class:list={["shots", { both: desktop && mobile }]}>
          {desktop && (
            <figure class="browser">
              <div class="bar" aria-hidden="true">
                <span class="dots">
                  <i />
                  <i />
                  <i />
                </span>
                {host && <span class="address">{host}</span>}
              </div>
              <a href={`/${desktop.src}`} data-lightbox title={t(locale, "enlarge")}>
                <img
                  src={`/${desktop.src}`}
                  alt={text(desktop.alt, locale)}
                  width="1440"
                  height="900"
                  style={shotStyle(desktop)}
                />
              </a>
            </figure>
          )}
          {mobile && (
            <figure class="phone">
              <a href={`/${mobile.src}`} data-lightbox title={t(locale, "enlarge")}>
                <img
                  src={`/${mobile.src}`}
                  alt={text(mobile.alt, locale)}
                  width="390"
                  height="844"
                  loading="lazy"
                  style={shotStyle(mobile)}
                />
              </a>
            </figure>
          )}
        </div>
      )
    }

    <div class="description" set:html={renderMarkdown(text(project.description, locale))} />

    {
      pager.length > 0 && (
        <nav class="pager">
          {pager.map(({ project: p, label, rel }) => {
            const shot = coverShot(p);
            return (
              <a class:list={["pager-link", rel]} href={projectUrl(p, locale, portfolio)} rel={rel}>
                <span class="thumb">
                  {shot ? (
                    <img
                      src={`/${shot.src}`}
                      alt=""
                      loading="lazy"
                      width={shot.viewport === "mobile" ? 390 : 1440}
                      height={shot.viewport === "mobile" ? 844 : 900}
                    />
                  ) : (
                    <span class="placeholder">{text(p.title, locale).charAt(0)}</span>
                  )}
                </span>
                <span class="pager-text">
                  <span class="pager-label">
                    {rel === "prev" ? "← " : ""}
                    {label}
                    {rel === "next" ? " →" : ""}
                  </span>
                  <span class="pager-title">{text(p.title, locale)}</span>
                </span>
              </a>
            );
          })}
        </nav>
      )
    }
  </article>

  <dialog class="lightbox" data-lightbox-dialog aria-label={t(locale, "enlarge")}>
    <button type="button" class="close" data-close aria-label={t(locale, "close")}>×</button>
    <img alt="" />
  </dialog>
</Base>

<script>
  // Screenshots open full size in a dialog; without JS the link opens the image itself.
  const dialog = document.querySelector<HTMLDialogElement>("[data-lightbox-dialog]");
  const image = dialog?.querySelector("img");
  if (dialog && image) {
    for (const link of document.querySelectorAll<HTMLAnchorElement>("a[data-lightbox]")) {
      link.addEventListener("click", (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
        event.preventDefault();
        const thumb = link.querySelector("img");
        image.src = link.href;
        image.alt = thumb?.alt ?? "";
        dialog.showModal();
      });
    }
    // Any click closes: on the backdrop, the image or the close button. Esc is native.
    dialog.addEventListener("click", () => dialog.close());
  }
</script>

<style>
  .project {
    max-width: 820px;
    padding: 32px 0;
  }
  .back {
    font-size: 14px;
    text-decoration: none;
  }
  h1 {
    font-size: clamp(28px, 5vw, 40px);
    line-height: 1.15;
    margin: 16px 0 8px;
    width: fit-content;
    max-width: 100%;
  }
  .summary {
    font-size: 19px;
    color: var(--muted);
    margin: 0 0 16px;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 16px;
    margin: 24px 0;
    padding: 16px 18px;
    background: var(--surface);
    border-radius: var(--radius);
  }
  dt {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  dd {
    margin: 4px 0 0;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0 0 28px;
  }
  .button {
    display: inline-block;
    padding: 9px 16px;
    border-radius: 10px;
    background: var(--accent);
    color: var(--on-accent);
    text-decoration: none;
    font-weight: 600;
    font-size: 15px;
    transition:
      transform 0.2s var(--ease-out),
      box-shadow 0.2s;
  }
  .button:hover {
    box-shadow: var(--shadow);
  }
  .button.secondary {
    background: transparent;
    color: var(--text);
    border: 1px solid var(--border);
  }

  /* Screenshots in device frames. */
  .shots {
    display: grid;
    gap: 20px;
    margin: 0 0 32px;
    align-items: end;
  }
  .shots.both {
    grid-template-columns: minmax(0, 1fr) minmax(0, 180px);
  }
  figure {
    margin: 0;
  }
  .shots a {
    display: block;
    cursor: zoom-in;
  }
  .shots img {
    width: 100%;
    height: auto;
  }
  .browser {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--frame);
    box-shadow: var(--shadow);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 34px;
    padding: 0 12px;
  }
  .dots {
    display: flex;
    gap: 6px;
  }
  .dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #ff5f57;
  }
  .dots i:nth-child(2) {
    background: #febc2e;
  }
  .dots i:nth-child(3) {
    background: #28c840;
  }
  .address {
    flex: 1;
    max-width: 360px;
    margin: 0 auto;
    padding: 2px 12px;
    border-radius: 6px;
    background: var(--bg);
    color: var(--muted);
    font-size: 12px;
    text-align: center;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .phone {
    position: relative;
    padding: 22px 6px 6px;
    border-radius: 30px;
    background: var(--frame);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    max-width: 260px;
  }
  .phone a {
    border-radius: 24px;
    overflow: hidden;
  }
  /* Dynamic island. */
  .phone::before {
    content: "";
    position: absolute;
    z-index: 1;
    top: 7px;
    left: 50%;
    translate: -50% 0;
    width: 28%;
    height: 12px;
    border-radius: 999px;
    background: #000;
  }
  @media (max-width: 560px) {
    .shots.both {
      grid-template-columns: minmax(0, 1fr) minmax(0, 96px);
      gap: 10px;
    }
    .bar {
      height: 24px;
      gap: 8px;
      padding: 0 8px;
    }
    .dots i {
      width: 7px;
      height: 7px;
    }
    .address {
      font-size: 10px;
      padding: 0 8px;
    }
    .phone {
      padding: 11px 3px 3px;
      border-radius: 16px;
    }
    .phone a {
      border-radius: 13px;
    }
    .phone::before {
      top: 3px;
      height: 6px;
    }
  }

  .description {
    font-size: 17px;
  }

  /* Previous / next project. */
  .pager {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 16px;
    margin-top: 48px;
    padding-top: 28px;
    border-top: 1px solid var(--border);
  }
  .pager-link {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    text-decoration: none;
    transition:
      transform 0.25s var(--ease-out),
      box-shadow 0.25s,
      border-color 0.25s;
  }
  .pager-link.next {
    grid-column: -2;
    flex-direction: row-reverse;
    text-align: right;
  }
  .pager-link:hover {
    border-color: color-mix(in srgb, var(--accent) 35%, var(--border));
    box-shadow: var(--shadow);
  }
  .thumb {
    flex: none;
    width: 96px;
    aspect-ratio: 16 / 10;
    border-radius: 8px;
    overflow: hidden;
    background: var(--surface);
    display: grid;
    place-items: center;
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .thumb .placeholder {
    font-weight: 700;
    color: var(--muted);
  }
  .pager-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .pager-label {
    font-size: 13px;
    color: var(--muted);
  }
  .pager-title {
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Lightbox. */
  .lightbox {
    padding: 0;
    border: 0;
    background: transparent;
    max-width: 94vw;
    max-height: 92vh;
    overflow: visible;
    cursor: zoom-out;
  }
  .lightbox::backdrop {
    background: rgb(0 0 0 / 0.78);
    backdrop-filter: blur(4px);
  }
  .lightbox img {
    max-width: 94vw;
    max-height: 92vh;
    width: auto;
    height: auto;
    border-radius: 10px;
    box-shadow: 0 30px 80px -20px rgb(0 0 0 / 0.6);
  }
  .close {
    position: fixed;
    top: 12px;
    right: 12px;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.14);
    color: #fff;
    font-size: 26px;
    line-height: 1;
    cursor: pointer;
  }
  .close:hover {
    background: rgb(255 255 255 / 0.26);
  }

  @media (prefers-reduced-motion: no-preference) {
    .button:hover,
    .pager-link:hover {
      transform: translateY(-2px);
    }
    .lightbox[open] img {
      animation: zoom-in 0.28s var(--ease-out);
    }
    .lightbox[open]::backdrop {
      animation: fade-in 0.28s ease-out;
    }
  }
  @keyframes zoom-in {
    from {
      opacity: 0;
      scale: 0.94;
    }
  }
  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }
</style>
