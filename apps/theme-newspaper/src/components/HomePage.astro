---
import { coverShot, loadPortfolio, localePrefix, orderedProjects, projectUrl, projectYears, renderMarkdown, tagCounts, text } from "@japs/theme-kit";
import Base from "../layouts/Base.astro";
import { tt } from "../lib/strings.ts";

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const portfolio = loadPortfolio();
const { profile } = portfolio;
const home = (l: string) => `${localePrefix(l, portfolio)}/`;
const projects = orderedProjects(portfolio);
const present = tt(locale, "present");
const pageOf = (p: (typeof projects)[number]) => `A${projects.indexOf(p) + 1}`;
// The lead story: a featured project, else the first with a screenshot, else the first.
const lead = projects.find((p) => p.featured) ?? projects.find((p) => coverShot(p)) ?? projects[0];
const others = projects.filter((p) => p !== lead);
// Three stories with photos under the lead; the rest run as briefs.
const secondary = others.filter((p) => coverShot(p)).slice(0, 3);
const briefs = others.filter((p) => !secondary.includes(p));
const leadShot = lead ? coverShot(lead) : undefined;
// The lead runs its first two paragraphs on the front page.
const leadBody = lead ? text(lead.description, locale).split(/\n\s*\n/).slice(0, 2).join("\n\n") : "";
const quotes = tagCounts(portfolio).slice(0, 8);
const total = Math.max(1, portfolio.projects.length);
---

<Base
  locale={locale}
  title={`${profile.name} — ${text(profile.headline, locale)}`}
  description={text(profile.headline, locale)}
  alternates={portfolio.locales.map((l) => ({ locale: l, href: home(l) }))}
  homeHref={home(locale)}
  front
>
  {
    profile.available !== null && (
      <p class:list={["extra", { off: !profile.available }]}>
        <b>{tt(locale, "extra")}:</b> {tt(locale, profile.available ? "available" : "unavailable")}
      </p>
    )
  }

  <div class="front">
    {
      lead && (
        <article class="lead">
          <p class="kicker">{lead.client.isClient ? tt(locale, "clientWork") : tt(locale, "project")}</p>
          <h2 class="lead-head">
            <a href={projectUrl(lead, locale, portfolio)}>{text(lead.title, locale)}</a>
          </h2>
          <p class="deck">{text(lead.summary, locale)}</p>
          <p class="byline">
            {tt(locale, "by")} <b>{profile.name}</b> · {projectYears(lead, present)}
          </p>
          {leadShot && (
            <a href={projectUrl(lead, locale, portfolio)} class="lead-photo">
              <figure class="halftone">
                <img src={`/${leadShot.src}`} alt={text(leadShot.alt, locale)} width={leadShot.viewport === "mobile" ? 390 : 1440} height={leadShot.viewport === "mobile" ? 844 : 900} />
              </figure>
              <p class="caption">{text(leadShot.alt, locale)}</p>
            </a>
          )}
          <div class="lead-body columns" set:html={renderMarkdown(leadBody)} />
          <p class="continued">
            <a href={projectUrl(lead, locale, portfolio)}>
              {tt(locale, "continued")} {pageOf(lead)} →
            </a>
          </p>
        </article>
      )
    }

    <aside class="sidebar">
      <section class="box" aria-labelledby="index-title">
        <h2 id="index-title" class="box-title">{tt(locale, "inThisEdition")}</h2>
        <ol class="index">
          {
            projects.map((p) => (
              <li>
                <a href={projectUrl(p, locale, portfolio)}>{text(p.title, locale)}</a>
                <span class="leader" aria-hidden="true" />
                <span class="page-ref">
                  {tt(locale, "page")} {pageOf(p)}
                </span>
              </li>
            ))
          }
        </ol>
      </section>
      <section class="box forecast" aria-labelledby="forecast-title">
        <h2 id="forecast-title" class="box-title">{tt(locale, "forecast")}</h2>
        <p class="sun" aria-hidden="true">☀</p>
        <p>{tt(locale, "forecastText")}</p>
      </section>
    </aside>
  </div>

  {
    secondary.length > 0 && (
      <section class="secondary" aria-label={tt(locale, "moreStories")}>
        {secondary.map((p) => {
          const shot = coverShot(p)!;
          return (
            <article class="story">
              <a href={projectUrl(p, locale, portfolio)}>
                <figure class="halftone">
                  <img src={`/${shot.src}`} alt={text(shot.alt, locale)} loading="lazy" width={shot.viewport === "mobile" ? 390 : 1440} height={shot.viewport === "mobile" ? 844 : 900} />
                </figure>
                <h3>{text(p.title, locale)}</h3>
              </a>
              <p class="byline">
                {projectYears(p, present)} · {tt(locale, "page")} {pageOf(p)}
              </p>
              <p class="summary">{text(p.summary, locale)}</p>
              <a class="more" href={projectUrl(p, locale, portfolio)}>
                {tt(locale, "readMore")} →
              </a>
            </article>
          );
        })}
      </section>
    )
  }

  {
    briefs.length > 0 && (
      <section class="briefs" aria-labelledby="briefs-title">
        <h2 id="briefs-title" class="section-flag">{tt(locale, "briefs")}</h2>
        <div class="briefs-cols">
          {briefs.map((p) => (
            <article class="brief">
              <h3>
                <a href={projectUrl(p, locale, portfolio)}>{text(p.title, locale)}</a>
              </h3>
              <p>
                <span class="brief-year">{projectYears(p, present)} —</span> {text(p.summary, locale)}
              </p>
            </article>
          ))}
        </div>
      </section>
    )
  }

  <div class="bottom">
    {
      quotes.length > 0 && (
        <section class="market" aria-labelledby="market-title">
          <h2 id="market-title" class="section-flag">{tt(locale, "techIndex")}</h2>
          <table>
            <tbody>
              {quotes.map(({ tag, count }) => (
                <tr>
                  <th scope="row">{tag.toUpperCase()}</th>
                  <td class="num">{count}</td>
                  <td class="delta">▲ {((count / total) * 100).toFixed(1)}%</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      )
    }
    <section class="classifieds" aria-labelledby="ads-title" id="contact">
      <h2 id="ads-title" class="section-flag">{tt(locale, "classifieds")}</h2>
      <div class="ad">
        <p class="ad-head">{tt(locale, "wanted")}</p>
        <p>{tt(locale, profile.available === false ? "unavailableText" : "wantedText")}</p>
        {profile.email && (
          <p class="ad-contact">
            <a href={`mailto:${profile.email}`}>{profile.email}</a>
          </p>
        )}
        <p class="ad-sign">— {profile.name}</p>
      </div>
    </section>
  </div>
</Base>

<style>
  .extra {
    margin: 10px 0 0;
    padding: 7px 12px;
    background: var(--ink);
    color: var(--paper);
    font: 600 14px/1.3 var(--serif);
    letter-spacing: 0.04em;
    text-align: center;
  }
  .extra b {
    color: #ffb3a8;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .extra.off b {
    color: var(--paper-2);
  }

  .front {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(240px, 300px);
    gap: 0 28px;
    padding-top: 22px;
  }
  .lead {
    padding-right: 28px;
    border-right: 1px solid var(--ink);
  }
  .lead-head {
    margin: 6px 0 0;
    font: 900 clamp(40px, 6.4vw, 88px) / 0.96 var(--display);
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }
  .lead-head a,
  .story h3,
  .brief a {
    text-decoration: none;
  }
  .lead-head a:hover,
  .story a:hover h3,
  .brief a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }
  .deck {
    max-width: 52ch;
    margin: 14px 0 0;
    font: italic 400 clamp(19px, 1.9vw, 24px) / 1.3 var(--display);
  }
  .byline {
    margin: 10px 0 0;
    color: var(--soft);
    font: 600 12px/1.4 var(--serif);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .byline b {
    color: var(--ink);
  }
  .lead-photo {
    display: block;
    margin-top: 18px;
    text-decoration: none;
  }
  .lead-photo .halftone {
    aspect-ratio: 16 / 9;
  }
  .lead-photo img {
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  /* Body copy set in justified columns with a drop cap. */
  .columns {
    columns: 2 18em;
    column-gap: 28px;
    column-rule: 1px solid rgb(27 26 23 / 0.35);
    margin-top: 18px;
    text-align: justify;
    hyphens: auto;
  }
  .columns :global(p) {
    margin: 0 0 0.8em;
  }
  .columns > :global(p:first-child::first-letter) {
    float: left;
    margin: 0.04em 0.08em 0 0;
    font: 900 4.1em/0.8 var(--display);
  }
  .continued {
    margin: 6px 0 0;
    font: italic 600 14px/1.4 var(--serif);
    text-align: right;
  }
  .continued a:hover,
  .more:hover {
    color: var(--red);
  }

  .box {
    padding: 0 0 18px;
    border-bottom: 1px solid var(--ink);
  }
  .box + .box {
    padding-top: 14px;
  }
  .box-title,
  .section-flag {
    margin: 0 0 10px;
    padding: 4px 0;
    border-top: 3px double var(--ink);
    border-bottom: 1px solid var(--ink);
    font: 800 14px/1.3 var(--display);
    letter-spacing: 0.12em;
    text-align: center;
    text-transform: uppercase;
  }
  .index {
    display: grid;
    gap: 5px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 14px;
  }
  .index li {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }
  .index a {
    min-width: 0;
    text-decoration: none;
  }
  .index a:hover {
    text-decoration: underline;
  }
  /* Dotted leaders to the page number. */
  .leader {
    flex: 1;
    min-width: 12px;
    border-bottom: 1px dotted var(--muted);
  }
  .page-ref {
    flex: none;
    color: var(--soft);
    font-style: italic;
  }
  .forecast {
    text-align: center;
  }
  .forecast p {
    margin: 0;
    font: italic 400 15px/1.45 var(--serif);
  }
  .forecast .sun {
    font-size: 44px;
    font-style: normal;
    line-height: 1.1;
  }

  .secondary {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 28px;
    padding-top: 18px;
    border-top: 3px double var(--ink);
  }
  .story {
    padding: 0 20px;
    border-left: 1px solid var(--ink);
  }
  .story:first-child {
    padding-left: 0;
    border-left: 0;
  }
  .story:last-child {
    padding-right: 0;
  }
  .story > a:first-child {
    text-decoration: none;
  }
  .story .halftone {
    aspect-ratio: 16 / 10;
  }
  .story img {
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .story h3 {
    margin: 12px 0 0;
    font: 800 26px/1.05 var(--display);
  }
  .summary {
    margin: 8px 0 0;
    text-align: justify;
    hyphens: auto;
  }
  .more {
    display: inline-block;
    margin-top: 6px;
    font: italic 600 14px/1.4 var(--serif);
    text-decoration: none;
  }

  .briefs {
    margin-top: 32px;
  }
  .briefs-cols {
    columns: 4 14em;
    column-gap: 24px;
    column-rule: 1px solid rgb(27 26 23 / 0.35);
  }
  .brief {
    break-inside: avoid;
    padding-bottom: 12px;
    margin-bottom: 12px;
    border-bottom: 1px solid rgb(27 26 23 / 0.25);
  }
  .brief h3 {
    margin: 0;
    font: 800 18px/1.15 var(--display);
  }
  .brief p {
    margin: 4px 0 0;
    font-size: 14px;
    line-height: 1.45;
    text-align: justify;
    hyphens: auto;
  }
  .brief-year {
    font-weight: 700;
  }

  .bottom {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 28px;
    margin-top: 28px;
  }
  .market table {
    width: 100%;
    border-collapse: collapse;
    font: 400 14px/1.3 var(--serif);
    font-variant-numeric: tabular-nums;
  }
  .market th,
  .market td {
    padding: 5px 4px;
    border-bottom: 1px dotted var(--muted);
  }
  .market th {
    font-weight: 700;
    letter-spacing: 0.06em;
    text-align: left;
  }
  .num,
  .delta {
    text-align: right;
  }
  .delta {
    width: 6em;
    color: #2e6b2f;
  }
  .ad {
    padding: 14px 16px;
    border: 2px solid var(--ink);
    outline: 1px solid var(--ink);
    outline-offset: 3px;
    text-align: center;
  }
  .ad p {
    margin: 6px 0 0;
  }
  .ad-head {
    font: 900 28px/1 var(--display);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .ad-contact a {
    font-weight: 700;
    overflow-wrap: anywhere;
  }
  .ad-contact a:hover {
    color: var(--red);
  }
  .ad-sign {
    font-style: italic;
  }

  @media (max-width: 900px) {
    .front {
      grid-template-columns: minmax(0, 1fr);
    }
    .lead {
      padding-right: 0;
      border-right: 0;
    }
    .sidebar {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 0 24px;
      margin-top: 24px;
      padding-top: 14px;
      border-top: 3px double var(--ink);
    }
    .box + .box {
      padding-top: 0;
    }
    .secondary {
      grid-template-columns: minmax(0, 1fr);
      gap: 22px;
    }
    .story,
    .story:first-child,
    .story:last-child {
      padding: 0 0 22px;
      border-left: 0;
      border-bottom: 1px solid var(--ink);
    }
    .bottom {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 600px) {
    .sidebar {
      grid-template-columns: minmax(0, 1fr);
    }
    .box + .box {
      padding-top: 14px;
    }
    .columns {
      text-align: left;
    }
  }
</style>
