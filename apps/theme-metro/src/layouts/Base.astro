---
import "@fontsource-variable/overpass/wght.css";
import "@fontsource-variable/doto/wght.css";
import { languageName, loadPortfolio, text } from "@japs/theme-kit";
import { tt } from "../lib/strings.ts";

interface Props {
  locale: string;
  title: string;
  description: string;
  alternates: { locale: string; href: string }[];
  homeHref: string;
}

const { locale, title, description, alternates, homeHref } = Astro.props;
const { profile } = loadPortfolio();
const site = Astro.site;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#14235c" />
    {site && alternates.map((a) => <link rel="alternate" hreflang={a.locale} href={new URL(a.href, site).toString()} />)}
    <link rel="icon" href={`data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><path d='M0 16h32' stroke='%23e1251b' stroke-width='8'/><rect x='6' y='6' width='20' height='20' rx='10' fill='%23fff' stroke='%231c1c1c' stroke-width='4'/></svg>`} />
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href={homeHref}>
        <svg viewBox="0 0 48 24" width="48" height="24" aria-hidden="true">
          <path d="M0 12h48" stroke="#e1251b" stroke-width="7" />
          <rect x="14" y="2" width="20" height="20" rx="10" fill="#fff" stroke="#1c1c1c" stroke-width="3.5" />
        </svg>
        <span>{profile.name}</span>
      </a>
      <nav class="nav" aria-label={tt(locale, "network")}>
        <a href={`${homeHref}#map`}>{tt(locale, "network")}</a>
        <a href={`${homeHref}#departures`}>{tt(locale, "departures")}</a>
        <a href="#enquiries">{tt(locale, "enquiries")}</a>
      </nav>
      {
        alternates.length > 1 && (
          <nav class="languages" aria-label={tt(locale, "language")}>
            {alternates.map((a) => (
              <a href={a.href} hreflang={a.locale} lang={a.locale} aria-current={a.locale === locale ? "page" : undefined} title={languageName(a.locale)}>
                {a.locale.toUpperCase()}
              </a>
            ))}
          </nav>
        )
      }
    </header>

    <main><slot /></main>

    <footer class="footer" id="enquiries">
      <div class="footer-sign">
        <span class="sign-label">{tt(locale, "enquiries")}</span>
        <p class="footer-name">{profile.name}</p>
        <p class="footer-headline">{text(profile.headline, locale)}</p>
      </div>
      <ul class="footer-links">
        {profile.email && (
          <li>
            <a href={`mailto:${profile.email}`}>{profile.email}</a>
          </li>
        )}
        {profile.links.map((link) => (
          <li>
            <a href={link.url} rel="me noopener">{link.label} ↗</a>
          </li>
        ))}
        {profile.location && <li class="muted">{profile.location}</li>}
      </ul>
      <p class="operator">
        {tt(locale, "operator")} {profile.name} · © {new Date().getFullYear()} · JAPS
      </p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --paper: #f4f2ec;
    --ink: #1c1c1c;
    --navy: #14235c;
    --accent: #0b6fbd;
    --muted: #6b6a66;
    --rule: #d9d5cb;
    --board: #121212;
    --amber: #ffb627;
    --sans: "Overpass Variable", "Helvetica Neue", Arial, sans-serif;
    --dots: "Doto Variable", ui-monospace, monospace;
    --pad: clamp(16px, 4vw, 48px);
  }
  * {
    box-sizing: border-box;
  }
  html {
    background: var(--paper);
    color: var(--ink);
    -webkit-text-size-adjust: 100%;
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
    min-width: 320px;
    overflow-x: clip;
    background: var(--paper);
    font: 400 16px/1.55 var(--sans);
  }
  a {
    color: inherit;
  }
  img {
    display: block;
    max-width: 100%;
    height: auto;
  }
  ::selection {
    background: #f6b500;
    color: var(--ink);
  }
  :focus-visible {
    outline: 3px solid #f6b500;
    outline-offset: 3px;
  }
  .muted {
    color: var(--muted);
  }
  /* White-on-navy station signage. */
  .sign-label {
    display: inline-block;
    padding: 4px 9px 2px;
    background: var(--navy);
    color: #fff;
    font: 800 12px/1.3 var(--sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .section-title {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0 0 22px;
    font: 800 clamp(28px, 3.4vw, 44px) / 1 var(--sans);
    letter-spacing: -0.01em;
  }
  .section-title::before {
    width: 26px;
    height: 26px;
    flex: none;
    border: 5px solid var(--ink);
    border-radius: 50%;
    background: #fff;
    content: "";
  }

  .topbar {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    gap: 12px 28px;
    flex-wrap: wrap;
    padding: 12px var(--pad);
    background: var(--navy);
    color: #fff;
  }
  .topbar a {
    text-decoration: none;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    font: 800 18px/1 var(--sans);
  }
  .nav {
    display: flex;
    gap: 22px;
    font: 700 14px/1 var(--sans);
  }
  .nav a,
  .languages a {
    padding: 4px 0;
    border-bottom: 2px solid transparent;
  }
  .nav a:hover,
  .languages a:hover {
    border-color: #f6b500;
  }
  .languages {
    display: flex;
    gap: 12px;
    margin-left: auto;
    font: 700 13px/1 var(--sans);
  }
  .languages a {
    color: rgb(255 255 255 / 0.6);
  }
  .languages a[aria-current="page"] {
    color: #fff;
    border-color: #fff;
  }

  .footer {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 24px 48px;
    margin-top: 120px;
    padding: 40px var(--pad) 28px;
    background: var(--navy);
    color: #fff;
  }
  .footer .sign-label {
    background: #fff;
    color: var(--navy);
  }
  .footer-name {
    margin: 16px 0 4px;
    font: 800 clamp(30px, 4vw, 52px) / 1 var(--sans);
  }
  .footer-headline {
    margin: 0;
    color: rgb(255 255 255 / 0.75);
  }
  .footer-links {
    display: grid;
    align-content: end;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-weight: 700;
    overflow-wrap: anywhere;
  }
  .footer-links a {
    text-decoration: underline;
    text-decoration-color: rgb(255 255 255 / 0.4);
    text-underline-offset: 4px;
  }
  .footer-links a:hover {
    text-decoration-color: #f6b500;
  }
  .footer .muted {
    color: rgb(255 255 255 / 0.6);
  }
  .operator {
    grid-column: 1 / -1;
    margin: 12px 0 0;
    padding-top: 16px;
    border-top: 1px solid rgb(255 255 255 / 0.25);
    color: rgb(255 255 255 / 0.6);
    font-size: 13px;
  }

  @media (max-width: 760px) {
    .nav {
      display: none;
    }
    .footer {
      grid-template-columns: minmax(0, 1fr);
      margin-top: 80px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
    }
  }
</style>
