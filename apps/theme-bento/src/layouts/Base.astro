---
import "@fontsource-variable/geist/wght.css";
import "@fontsource-variable/geist-mono/wght.css";
import { languageName, loadPortfolio } from "@japs/theme-kit";
import { tt } from "../lib/strings.ts";

interface Props {
  locale: string;
  title: string;
  description: string;
  alternates: { locale: string; href: string }[];
  homeHref: string;
}

const { locale, title, description, alternates, homeHref } = Astro.props;
const { profile } = loadPortfolio();
const site = Astro.site;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f3f3f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)" />
    {site && alternates.map((a) => <link rel="alternate" hreflang={a.locale} href={new URL(a.href, site).toString()} />)}
    <link rel="icon" href={`data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect x='2' y='2' width='16' height='16' rx='4' fill='%237c5cff'/><rect x='20' y='2' width='10' height='16' rx='4' fill='%233fa9ff'/><rect x='2' y='20' width='28' height='10' rx='4' fill='%2399a1b3'/></svg>`} />
  </head>
  <body>
    <header class="nav-wrap">
      <nav class="nav" aria-label={tt(locale, "overview")}>
        <a class="nav-name" href={homeHref}>{profile.name}</a>
        <span class="nav-links">
          <a href={`${homeHref}#work`}>{tt(locale, "work")}</a>
          <a href="#contact">{tt(locale, "contact")}</a>
        </span>
        {
          alternates.length > 1 && (
            <span class="languages">
              {alternates.map((a) => (
                <a href={a.href} hreflang={a.locale} lang={a.locale} aria-current={a.locale === locale ? "page" : undefined} title={languageName(a.locale)}>
                  {a.locale.toUpperCase()}
                </a>
              ))}
            </span>
          )
        }
      </nav>
    </header>

    <main><slot /></main>

    <footer class="footer">
      <span>© {new Date().getFullYear()} {profile.name}</span>
      <span class="mono">JAPS · bento</span>
    </footer>

    <script>
      // A soft light follows the pointer across each tile.
      if (matchMedia("(hover: hover)").matches) {
        document.addEventListener("pointermove", (e) => {
          const tile = (e.target as Element | null)?.closest<HTMLElement>(".tile");
          if (!tile) return;
          const r = tile.getBoundingClientRect();
          tile.style.setProperty("--mx", `${e.clientX - r.left}px`);
          tile.style.setProperty("--my", `${e.clientY - r.top}px`);
        });
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f3f3f5;
    --tile: #ffffff;
    --tile-2: #f7f7f9;
    --line: rgb(0 0 0 / 0.07);
    --text: #111114;
    --muted: #6b6b76;
    --accent: #6d4aff;
    --accent-2: #2f8fff;
    --glow: rgb(109 74 255 / 0.1);
    --shadow: 0 1px 2px rgb(0 0 0 / 0.04), 0 8px 24px -12px rgb(0 0 0 / 0.12);
    --sans: "Geist Variable", system-ui, sans-serif;
    --mono: "Geist Mono Variable", ui-monospace, monospace;
    --gap: 14px;
    --radius: 22px;
    --pad: clamp(14px, 3vw, 32px);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #09090b;
      --tile: #131317;
      --tile-2: #1a1a20;
      --line: rgb(255 255 255 / 0.08);
      --text: #ededf0;
      --muted: #8d8d98;
      --accent: #8b6dff;
      --accent-2: #4fb0ff;
      --glow: rgb(139 109 255 / 0.16);
      --shadow: 0 1px 0 rgb(255 255 255 / 0.04) inset, 0 12px 30px -16px rgb(0 0 0 / 0.8);
    }
  }
  * {
    box-sizing: border-box;
  }
  html {
    background: var(--bg);
    color: var(--text);
    -webkit-text-size-adjust: 100%;
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
    min-width: 320px;
    overflow-x: clip;
    background: var(--bg);
    font: 400 15px/1.55 var(--sans);
    -webkit-font-smoothing: antialiased;
  }
  a {
    color: inherit;
  }
  img {
    display: block;
    max-width: 100%;
    height: auto;
  }
  ::selection {
    background: var(--accent);
    color: #fff;
  }
  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  main {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 var(--pad);
  }
  .mono {
    font-family: var(--mono);
  }
  .eyebrow {
    margin: 0;
    color: var(--muted);
    font: 500 12px/1.3 var(--mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* The bento grid and its tiles. */
  .bento {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gap);
  }
  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 22px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--tile);
    box-shadow: var(--shadow);
    isolation: isolate;
  }
  /* Pointer spotlight (see the script in Base). */
  .tile::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    content: "";
    background: radial-gradient(420px circle at var(--mx, -999px) var(--my, -999px), var(--glow), transparent 60%);
    opacity: 0;
    transition: opacity 0.3s;
  }
  .tile:hover::before {
    opacity: 1;
  }
  a.tile {
    text-decoration: none;
    transition:
      transform 0.25s,
      border-color 0.25s;
  }
  a.tile:hover {
    border-color: color-mix(in srgb, var(--accent) 40%, var(--line));
    transform: translateY(-2px);
  }
  .s-3 { grid-column: span 3; }
  .s-4 { grid-column: span 4; }
  .s-5 { grid-column: span 5; }
  .s-6 { grid-column: span 6; }
  .s-7 { grid-column: span 7; }
  .s-8 { grid-column: span 8; }
  .s-12 { grid-column: span 12; }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--tile-2);
    font-size: 13px;
    white-space: nowrap;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px 16px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--tile-2);
    color: var(--text);
    font: 500 14px/1 var(--sans);
    text-decoration: none;
    cursor: pointer;
  }
  .btn:hover {
    border-color: color-mix(in srgb, var(--accent) 50%, var(--line));
  }
  .btn.primary {
    border-color: transparent;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    color: #fff;
  }

  .nav-wrap {
    position: sticky;
    top: 12px;
    z-index: 30;
    display: flex;
    justify-content: center;
    padding: 12px var(--pad) 0;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 8px 10px 8px 18px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--tile) 75%, transparent);
    box-shadow: var(--shadow);
    backdrop-filter: blur(14px) saturate(1.4);
    font-size: 14px;
  }
  .nav a {
    text-decoration: none;
  }
  .nav-name {
    font-weight: 600;
  }
  .nav-links {
    display: flex;
    gap: 14px;
    color: var(--muted);
  }
  .nav-links a:hover {
    color: var(--text);
  }
  .languages {
    display: flex;
    gap: 2px;
    padding: 2px;
    border-radius: 999px;
    background: var(--tile-2);
    font: 500 12px/1 var(--mono);
  }
  .languages a {
    padding: 6px 9px;
    border-radius: 999px;
    color: var(--muted);
  }
  .languages a[aria-current="page"] {
    background: var(--tile);
    color: var(--text);
    box-shadow: var(--shadow);
  }
  .footer {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    max-width: 1280px;
    margin: 0 auto;
    padding: 40px var(--pad) 32px;
    color: var(--muted);
    font-size: 13px;
  }

  @media (max-width: 900px) {
    .s-3 { grid-column: span 6; }
    .s-4,
    .s-5,
    .s-7 { grid-column: span 6; }
    .s-6,
    .s-8 { grid-column: span 12; }
  }
  @media (max-width: 600px) {
    :root {
      --gap: 10px;
      --radius: 18px;
    }
    .tile {
      padding: 18px;
    }
    .s-4,
    .s-5,
    .s-7 { grid-column: span 12; }
    .nav-links {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
    }
  }
</style>
