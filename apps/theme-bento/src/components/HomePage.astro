---
import { coverShot, loadPortfolio, localePrefix, orderedProjects, plural, portfolioStats, projectUrl, projectYears, tagCounts, text } from "@japs/theme-kit";
import Base from "../layouts/Base.astro";
import { projectSpans, projectsPerYear } from "../lib/layout.ts";
import { tt } from "../lib/strings.ts";

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const portfolio = loadPortfolio();
const { profile } = portfolio;
const home = (l: string) => `${localePrefix(l, portfolio)}/`;
const projects = orderedProjects(portfolio);
const spans = projectSpans(projects.map((p) => coverShot(p) !== undefined));
const stats = portfolioStats(portfolio);
const tags = tagCounts(portfolio);
const perYear = projectsPerYear(portfolio.projects);
const maxYear = Math.max(1, ...perYear.map((y) => y.count));
const present = tt(locale, "present");
const initials = profile.name
  .trim()
  .split(/\s+/)
  .map((w) => w[0] ?? "")
  .join("")
  .slice(0, 2)
  .toUpperCase();
// Two marquee rows of technologies, the second running the other way.
const half = Math.ceil(tags.length / 2);
const marquee = [tags.slice(0, half), tags.slice(half)].filter((row) => row.length > 0);
const range = perYear.length ? `${perYear[0]!.year} – ${perYear[perYear.length - 1]!.year}` : "";
---

<Base
  locale={locale}
  title={`${profile.name} — ${text(profile.headline, locale)}`}
  description={text(profile.headline, locale)}
  alternates={portfolio.locales.map((l) => ({ locale: l, href: home(l) }))}
  homeHref={home(locale)}
>
  <section class="bento top" aria-label={tt(locale, "overview")}>
    <div class="tile s-6 profile">
      <span class="avatar" aria-hidden="true">{initials}</span>
      <h1>{profile.name}</h1>
      <p class="headline">{text(profile.headline, locale)}</p>
      {text(profile.bio, locale) && <p class="bio">{text(profile.bio, locale)}</p>}
      {
        profile.available !== null && (
          <p class:list={["status", { off: !profile.available }]}>
            <i aria-hidden="true" />
            {tt(locale, profile.available ? "available" : "unavailable")}
          </p>
        )
      }
    </div>

    <div class="tile s-3 stat">
      <p class="eyebrow">{plural(locale, "projects", stats.projects)}</p>
      <p class="big">{stats.projects}</p>
      {
        perYear.length > 1 && (
          <span class="spark" aria-hidden="true">
            {perYear.map((y) => (
              <i style={`height: ${Math.max(8, Math.round((y.count / maxYear) * 100))}%`} />
            ))}
          </span>
        )
      }
    </div>
    <div class="tile s-3 stat">
      <p class="eyebrow">{plural(locale, "technologies", stats.technologies)}</p>
      <p class="big">{stats.technologies}</p>
      <span class="top-tags">{tags.slice(0, 3).map(({ tag }) => <span class="chip">{tag}</span>)}</span>
    </div>
    {
      stats.years !== null && (
        <div class="tile s-3 stat">
          <p class="eyebrow">{plural(locale, "years", stats.years)}</p>
          <p class="big">{stats.years}</p>
          <span class="range mono">{range}</span>
        </div>
      )
    }
    {
      profile.location && (
        <div class="tile s-3 place">
          <span class="dots" aria-hidden="true" />
          <span class="pin" aria-hidden="true" />
          <p class="eyebrow">{tt(locale, "basedIn")}</p>
          <p class="place-name">{profile.location}</p>
        </div>
      )
    }

    <div class="tile s-4 links">
      <p class="eyebrow">{tt(locale, "findMe")}</p>
      <ul>
        {profile.links.map((link) => (
          <li>
            <a href={link.url} rel="me noopener">
              <span>{link.label}</span>
              <span class="arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
        {profile.email && (
          <li>
            <a href={`mailto:${profile.email}`}>
              <span>{profile.email}</span>
              <span class="arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        )}
      </ul>
    </div>
    {
      marquee.length > 0 && (
        <div class="tile s-8 stack">
          <p class="eyebrow">{tt(locale, "stackTitle")}</p>
          <div class="marquee">
            {marquee.map((row, r) => (
              <div class:list={["track", { reverse: r === 1 }]}>
                {[0, 1].map((copy) => (
                  <span class="track-set" aria-hidden={copy === 1 ? "true" : undefined}>
                    {row.map(({ tag, count }) => (
                      <span class="chip">
                        {tag}
                        <b>{count}</b>
                      </span>
                    ))}
                  </span>
                ))}
              </div>
            ))}
          </div>
        </div>
      )
    }
  </section>

  <section class="work" id="work" aria-labelledby="work-title">
    <header class="work-head">
      <h2 id="work-title">{tt(locale, "selected")}</h2>
      <span class="count mono">{String(projects.length).padStart(2, "0")}</span>
    </header>
    <div class="bento">
      {
        projects.map((project, i) => {
          const shot = coverShot(project);
          const span = spans[i]!;
          return (
            <a class:list={["tile", "project", `s-${span}`, { wide: span >= 7 }]} href={projectUrl(project, locale, portfolio)}>
              <span class="media">
                {shot ? (
                  <img src={`/${shot.src}`} alt={text(shot.alt, locale)} loading={i < 2 ? "eager" : "lazy"} width={shot.viewport === "mobile" ? 390 : 1440} height={shot.viewport === "mobile" ? 844 : 900} />
                ) : (
                  <span class="media-blank" aria-hidden="true">
                    {text(project.title, locale).charAt(0)}
                  </span>
                )}
              </span>
              <span class="project-head">
                <span class="project-title">{text(project.title, locale)}</span>
                <span class="project-year mono">{projectYears(project, present)}</span>
              </span>
              <span class="project-summary">{text(project.summary, locale)}</span>
              {project.tags.length > 0 && (
                <span class="project-tags">
                  {project.client.isClient && <span class="chip client">{tt(locale, "clientWork")}</span>}
                  {project.tags.slice(0, 3).map((tag) => (
                    <span class="chip">{tag}</span>
                  ))}
                </span>
              )}
            </a>
          );
        })
      }
    </div>
  </section>

  <section class="bento bottom" id="contact" aria-label={tt(locale, "contact")}>
    {
      perYear.length > 0 && (
        <div class="tile s-7 activity">
          <p class="eyebrow">{tt(locale, "activity")}</p>
          <p class="hint">{tt(locale, "activityHint")}</p>
          <div class="chart">
            {perYear.map((y) => (
              <div class="bar-col">
                <span class="bar-value mono">{y.count}</span>
                <span class="bar" style={`height: ${Math.max(4, Math.round((y.count / maxYear) * 130))}px`} />
                <span class="bar-year mono">{y.year}</span>
              </div>
            ))}
          </div>
        </div>
      )
    }
    <div class:list={["tile", "cta", perYear.length > 0 ? "s-5" : "s-12"]}>
      <p class="eyebrow">{tt(locale, "contact")}</p>
      <p class="cta-title">{tt(locale, "letsTalk")}</p>
      {
        profile.email ? (
          <div class="cta-actions">
            <a class="btn primary" href={`mailto:${profile.email}`}>
              {profile.email}
            </a>
            <button class="btn copy" type="button" data-copy={profile.email} data-done={tt(locale, "copied")} hidden>
              {tt(locale, "copy")}
            </button>
          </div>
        ) : (
          <div class="cta-actions">
            {profile.links.slice(0, 2).map((link) => (
              <a class="btn" href={link.url} rel="me noopener">
                {link.label} ↗
              </a>
            ))}
          </div>
        )
      }
    </div>
  </section>
</Base>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    if (!navigator.clipboard) continue;
    button.hidden = false;
    const label = button.textContent;
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? "");
        button.textContent = button.dataset.done ?? label;
        setTimeout(() => (button.textContent = label), 1600);
      } catch {}
    });
  }
</script>

<style>
  .top {
    padding-top: 28px;
  }
  .profile {
    grid-row: span 2;
    justify-content: flex-end;
    gap: 10px;
    min-height: 340px;
    background:
      radial-gradient(ellipse 80% 70% at 100% 0, color-mix(in srgb, var(--accent) 22%, transparent), transparent 70%),
      radial-gradient(ellipse 60% 60% at 80% 20%, color-mix(in srgb, var(--accent-2) 18%, transparent), transparent 70%),
      var(--tile);
  }
  /* Sits at the top; auto margin pushes the rest of the profile to the bottom. */
  .avatar {
    display: grid;
    margin-bottom: auto;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 16px;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    color: #fff;
    font: 600 20px/1 var(--sans);
  }
  h1 {
    margin: 0;
    font: 650 clamp(34px, 4.6vw, 58px) / 1 var(--sans);
    letter-spacing: -0.04em;
  }
  .headline {
    margin: 0;
    font-size: 18px;
    font-weight: 500;
  }
  .bio {
    max-width: 52ch;
    margin: 0;
    color: var(--muted);
  }
  .status {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: 8px;
    margin: 6px 0 0;
    padding: 6px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--tile-2);
    font-size: 13px;
  }
  .status i {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
  }
  .status i::after {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    content: "";
    background: #22c55e;
    animation: ping 1.8s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  .status.off i,
  .status.off i::after {
    background: var(--muted);
    animation: none;
  }
  @keyframes ping {
    75%,
    100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }

  .stat {
    justify-content: space-between;
    min-height: 160px;
  }
  .big {
    margin: 4px 0 0;
    background: linear-gradient(135deg, var(--text) 30%, var(--accent));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font: 600 clamp(48px, 5.4vw, 72px) / 1 var(--sans);
    letter-spacing: -0.05em;
  }
  .spark {
    display: flex;
    align-items: flex-end;
    gap: 4px;
    height: 34px;
    margin-top: 10px;
  }
  .spark i {
    flex: 1;
    border-radius: 3px;
    background: linear-gradient(var(--accent), var(--accent-2));
    opacity: 0.85;
  }
  .top-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 10px;
  }
  .range {
    margin-top: 10px;
    color: var(--muted);
    font-size: 13px;
  }
  .place {
    justify-content: flex-end;
    min-height: 160px;
  }
  /* A dotted map field with a pulsing pin. */
  .dots {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(color-mix(in srgb, var(--muted) 45%, transparent) 1.2px, transparent 1.4px) 0 0 / 12px 12px;
    mask-image: radial-gradient(ellipse 70% 60% at 60% 35%, #000, transparent 75%);
  }
  .pin {
    position: absolute;
    top: 34%;
    left: 60%;
    width: 14px;
    height: 14px;
    border: 3px solid var(--tile);
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--accent) 25%, transparent);
  }
  .place-name {
    margin: 4px 0 0;
    font-size: 20px;
    font-weight: 600;
  }
  .links ul {
    display: grid;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }
  .links a {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
    font-weight: 500;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .links li:last-child a {
    border-bottom: 0;
  }
  .links a:hover {
    color: var(--accent);
  }
  .arrow {
    color: var(--muted);
    transition: transform 0.2s;
  }
  .links a:hover .arrow {
    transform: translate(2px, -2px);
    color: var(--accent);
  }
  .stack {
    justify-content: space-between;
    gap: 16px;
  }
  .marquee {
    display: grid;
    gap: 10px;
    margin-inline: -22px;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .track {
    display: flex;
    width: max-content;
    animation: slide 40s linear infinite;
  }
  .track.reverse {
    animation-direction: reverse;
  }
  .track-set {
    display: flex;
    gap: 8px;
    padding-right: 8px;
  }
  .track .chip {
    padding: 7px 12px;
    font-size: 14px;
  }
  .chip b {
    color: var(--muted);
    font: 500 11px/1 var(--mono);
  }
  .stack:hover .track {
    animation-play-state: paused;
  }
  @keyframes slide {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .track {
      width: auto;
      animation: none;
    }
    .track-set {
      flex-wrap: wrap;
    }
    .track-set[aria-hidden] {
      display: none;
    }
    .marquee {
      margin-inline: 0;
      mask-image: none;
    }
  }

  .work {
    margin-top: 72px;
  }
  .work-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin: 0 4px 16px;
  }
  .work-head h2 {
    margin: 0;
    font: 650 clamp(26px, 3vw, 36px) / 1.1 var(--sans);
    letter-spacing: -0.03em;
  }
  .count {
    color: var(--muted);
  }
  .project {
    gap: 8px;
    padding: 12px 12px 18px;
  }
  .media {
    display: block;
    aspect-ratio: 16 / 10;
    margin-bottom: 8px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) - 10px);
    background: var(--tile-2);
  }
  .wide .media {
    aspect-ratio: 16 / 8.4;
  }
  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .project:hover .media img {
    transform: scale(1.03);
  }
  .media-blank {
    display: grid;
    place-items: center;
    height: 100%;
    background:
      radial-gradient(circle at 30% 20%, color-mix(in srgb, var(--accent) 30%, transparent), transparent 60%),
      radial-gradient(circle at 80% 90%, color-mix(in srgb, var(--accent-2) 30%, transparent), transparent 60%),
      var(--tile-2);
    color: color-mix(in srgb, var(--text) 70%, transparent);
    font: 650 72px/1 var(--sans);
  }
  .project-head,
  .project-summary,
  .project-tags {
    padding: 0 8px;
  }
  .project-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }
  .project-title {
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .wide .project-title {
    font-size: 22px;
  }
  .project-year {
    flex: none;
    color: var(--muted);
    font-size: 12px;
  }
  .project-summary {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    color: var(--muted);
    font-size: 14px;
  }
  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: auto;
    padding-top: 6px;
  }
  .project-tags .chip {
    font-size: 12px;
  }
  .chip.client {
    border-color: color-mix(in srgb, var(--accent) 40%, var(--line));
    color: var(--accent);
  }

  .bottom {
    margin-top: var(--gap);
  }
  .activity {
    min-height: 260px;
  }
  .hint {
    margin: 4px 0 0;
    color: var(--muted);
    font-size: 13px;
  }
  .chart {
    display: flex;
    align-items: flex-end;
    gap: 10px;
    flex: 1;
    min-height: 150px;
    margin-top: 18px;
  }
  .bar-col {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    gap: 6px;
    flex: 1;
  }
  .bar {
    width: 100%;
    max-width: 48px;
    min-height: 4px;
    border-radius: 8px 8px 4px 4px;
    background: linear-gradient(var(--accent), var(--accent-2));
  }
  .bar-value,
  .bar-year {
    color: var(--muted);
    font-size: 11px;
  }
  .cta {
    justify-content: flex-end;
    gap: 10px;
    min-height: 260px;
    background:
      radial-gradient(ellipse 90% 80% at 0 100%, color-mix(in srgb, var(--accent) 28%, transparent), transparent 70%),
      radial-gradient(ellipse 70% 70% at 100% 0, color-mix(in srgb, var(--accent-2) 22%, transparent), transparent 70%),
      var(--tile);
  }
  .cta-title {
    margin: 0;
    font: 650 clamp(28px, 3.2vw, 42px) / 1.05 var(--sans);
    letter-spacing: -0.03em;
  }
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 8px;
  }
  .cta-actions .btn.primary {
    overflow-wrap: anywhere;
  }

  @media (max-width: 900px) {
    .profile {
      grid-row: auto;
      min-height: 300px;
    }
  }
  @media (max-width: 600px) {
    .top {
      padding-top: 18px;
    }
    .stat,
    .place {
      min-height: 140px;
    }
    .marquee {
      margin-inline: -18px;
    }
    .work {
      margin-top: 48px;
    }
  }
</style>
