---
import "@fontsource-variable/space-grotesk";
import "@fontsource/dm-mono/400.css";
import { languageName, loadPortfolio } from "@japs/theme-kit";
import { tt } from "../lib/strings.ts";

interface Props {
  locale: string;
  title: string;
  description: string;
  alternates: { locale: string; href: string }[];
  homeHref: string;
}

const { locale, title, description, alternates, homeHref } = Astro.props;
const { profile } = loadPortfolio();
const site = Astro.site;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#e8efee" />
    {site && alternates.map((a) => <link rel="alternate" hreflang={a.locale} href={new URL(a.href, site).toString()} />)}
    <link rel="icon" href={`data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'><rect width='40' height='40' rx='20' fill='%23007f86'/><circle cx='20' cy='20' r='11' fill='none' stroke='%23e8efee' stroke-width='2'/><circle cx='20' cy='20' r='3' fill='%23f2694e'/></svg>`} />
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href={homeHref} aria-label={`${profile.name} portfolio`}><span class="brand-mark" aria-hidden="true"><i></i></span><span>ORBITAL <b>/ WORK INDEX</b></span></a>
      <div class="top-meta">
        {profile.location && <span>{profile.location}</span>}
        {profile.available !== null && <span class:list={["availability", { active: profile.available }]}><i aria-hidden="true"></i>{tt(locale, profile.available ? "available" : "unavailable")}</span>}
        {alternates.length > 1 && <nav class="languages" aria-label={tt(locale, "language")}>{alternates.map((a) => <a href={a.href} hreflang={a.locale} lang={a.locale} aria-current={a.locale === locale ? "page" : undefined} title={languageName(a.locale)}>{a.locale.toUpperCase()}</a>)}</nav>}
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="footer-orbit" aria-hidden="true"><i></i><b></b></div>
      <div class="footer-content"><span class="eyebrow">{tt(locale, "contact")}</span>{profile.email && <a class="footer-link" href={`mailto:${profile.email}`}>{tt(locale, "sayHello")} <span aria-hidden="true">↗</span></a>}{!profile.email && <span class="footer-link">{profile.name}</span>}</div>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} {profile.name}</span><div>{profile.email && <a href={`mailto:${profile.email}`}>{profile.email}</a>}{profile.links.map((link) => <a href={link.url} rel="me noopener">{link.label} ↗</a>)}</div><span>ORBITAL INDEX / 01</span></div>
    </footer>
    <script>
      import "../lib/motion.ts";
    </script>
  </body>
</html>

<style is:global>
  :root {
    --mist: #e8efee;
    --surface: #f4f7f5;
    --ink: #15363b;
    --muted: #5a777b;
    --line: #b7ccca;
    --orbit: #80aaa9;
    --teal: #007f86;
    --coral: #f2694e;
    --lime: #d6d259;
    --sans: "Space Grotesk Variable", "Helvetica Neue", sans-serif;
    --mono: "DM Mono", "Courier New", monospace;
    --pad: clamp(20px, 4.2vw, 64px);
  }
  * { box-sizing: border-box; }
  html { background: var(--mist); color: var(--ink); -webkit-text-size-adjust: 100%; }
  body { margin: 0; min-width: 320px; background: radial-gradient(circle at 50% 32%, #f4f7f5 0, var(--mist) 60%); color: var(--ink); font: 16px/1.5 var(--sans); }
  a { color: inherit; text-decoration: none; }
  img { display: block; max-width: 100%; height: auto; }
  ::selection { background: var(--teal); color: white; }
  :focus-visible { outline: 2px solid var(--coral); outline-offset: 4px; }
  .eyebrow, .mono { font: 10px/1.5 var(--mono); text-transform: uppercase; }
  .topbar { min-height: 66px; display: flex; justify-content: space-between; align-items: center; gap: 18px; padding: 12px var(--pad); border-bottom: 1px solid var(--line); }
  .brand { display: flex; align-items: center; gap: 10px; font: 11px/1.2 var(--mono); }
  .brand b { color: var(--muted); font-weight: 400; }
  .brand-mark { position: relative; width: 30px; height: 30px; display: grid; place-items: center; border: 1px solid var(--teal); border-radius: 50%; }
  .brand-mark::before { width: 19px; height: 8px; border: 1px solid var(--teal); border-radius: 50%; content: ""; rotate: -34deg; }
  .brand-mark i { position: absolute; width: 5px; height: 5px; border-radius: 50%; background: var(--coral); }
  .top-meta { display: flex; align-items: center; gap: 18px; color: var(--muted); font: 10px/1.4 var(--mono); }
  .availability { display: flex; align-items: center; gap: 7px; }
  .availability i { width: 6px; height: 6px; border: 1px solid currentColor; border-radius: 50%; }
  .availability.active i { border-color: var(--teal); background: var(--teal); }
  .languages { display: flex; gap: 4px; }
  .languages a { padding: 5px 6px; }
  .languages a[aria-current="page"] { background: var(--ink); color: var(--mist); }
  .site-footer { position: relative; min-height: 230px; margin-top: 100px; padding: 34px var(--pad) 18px; overflow: hidden; background: var(--ink); color: var(--mist); }
  .footer-content { position: relative; z-index: 1; display: grid; justify-items: start; gap: 8px; }
  .footer-content .eyebrow { color: #a8c0be; }
  .footer-link { font-size: 42px; line-height: 1.08; }
  .footer-link span { color: var(--lime); }
  .footer-link:hover { color: var(--lime); }
  .footer-orbit { position: absolute; top: -130px; right: 15%; width: 310px; aspect-ratio: 1; border: 1px solid #719493; border-radius: 50%; opacity: .45; }
  .footer-orbit::before, .footer-orbit::after { position: absolute; inset: 30px; border: 1px solid #719493; border-radius: 50%; content: ""; }
  .footer-orbit::after { inset: 67px; }
  .footer-orbit i { position: absolute; top: 42px; right: 12px; width: 11px; height: 11px; border-radius: 50%; background: var(--coral); }
  .footer-orbit b { position: absolute; bottom: 30px; left: 70px; width: 6px; height: 6px; border-radius: 50%; background: var(--lime); }
  .footer-bottom { position: relative; z-index: 1; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px 20px; margin-top: 56px; padding-top: 12px; border-top: 1px solid #496668; color: #afc5c3; font: 9px/1.5 var(--mono); }
  .footer-bottom > div { display: flex; flex-wrap: wrap; gap: 10px 16px; }
  .footer-bottom a:hover { color: var(--lime); }
  @media (max-width: 620px) {
    .topbar { min-height: 58px; }
    .top-meta { gap: 8px; }
    .top-meta > span:first-child { display: none; }
    .brand { gap: 7px; font-size: 9px; }
    .brand-mark { width: 27px; height: 27px; }
    .footer-link { font-size: 31px; }
    .site-footer { margin-top: 70px; }
  }
  @media (max-width: 380px) {
    .brand b { display: none; }
    .availability { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
  }
</style>