---
import "@fontsource-variable/bricolage-grotesque/standard.css";
import "@fontsource/dm-mono/400.css";
import { languageName, loadPortfolio } from "@japs/theme-kit";
import { tt } from "../lib/strings.ts";

interface Props {
  locale: string;
  title: string;
  description: string;
  alternates: { locale: string; href: string }[];
  homeHref: string;
}

const { locale, title, description, alternates, homeHref } = Astro.props;
const { profile } = loadPortfolio();
const site = Astro.site;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#f4f0e6" />
    {site && alternates.map((a) => <link rel="alternate" hreflang={a.locale} href={new URL(a.href, site).toString()} />)}
    <link rel="icon" href={`data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'><rect width='40' height='40' fill='%23ff5238'/><path d='M8 10h24v20H8z' fill='%23f4ed45' stroke='%231b1b19' stroke-width='3'/><text x='20' y='26' font-family='Arial,sans-serif' font-weight='900' font-size='17' fill='%231b1b19' text-anchor='middle'>!</text></svg>`} />
  </head>
  <body>
    <header class="masthead">
      <a class="logo" href={homeHref} aria-label={`${profile.name} portfolio`}><span class="logo-mark">J!</span><span>JAPS <i>INDEPENDENT WORKS</i></span></a>
      <div class="header-right">
        {profile.available === true && <span class="available"><i aria-hidden="true"></i>{tt(locale, "available")}</span>}
        {alternates.length > 1 && <nav class="languages" aria-label={tt(locale, "language")}>{alternates.map((a) => <a href={a.href} hreflang={a.locale} lang={a.locale} aria-current={a.locale === locale ? "page" : undefined} title={languageName(a.locale)}>{a.locale.toUpperCase()}</a>)}</nav>}
      </div>
    </header>
    <div class="ticker" aria-label={tt(locale, "punchline")}><div class="ticker-track"><span>{tt(locale, "punchline")} ✳ {profile.name} ✳ {tt(locale, "selected")} ✳ </span><span aria-hidden="true">{tt(locale, "punchline")} ✳ {profile.name} ✳ {tt(locale, "selected")} ✳ </span></div></div>
    <main><slot /></main>
    <footer class="footer">
      <div class="footer-top"><span class="footer-stamp" aria-hidden="true">LET'S<br />GO!</span><div><span class="eyebrow">{tt(locale, "contact")}</span>{profile.email && <a class="footer-cta" href={`mailto:${profile.email}`}>{tt(locale, "sayHello")} <span aria-hidden="true">↗</span></a>}{!profile.email && <span class="footer-cta">{profile.name}</span>}</div></div>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} {profile.name}</span><div>{profile.email && <a href={`mailto:${profile.email}`}>{profile.email}</a>}{profile.links.map((link) => <a href={link.url} rel="me noopener">{link.label} ↗</a>)}</div><span class="edition">{tt(locale, "issue")} Nº 01</span></div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --paper: #f4f0e6;
    --ink: #1b1b19;
    --orange: #ff5238;
    --lemon: #f4ed45;
    --cyan: #48d5cd;
    --pink: #ff91b7;
    --muted: #69665e;
    --rule: #1b1b19;
    --display: "Bricolage Grotesque Variable", "Arial Black", sans-serif;
    --mono: "DM Mono", "Courier New", monospace;
    --pad: 34px;
  }
  * { box-sizing: border-box; }
  html { background: var(--paper); color: var(--ink); -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
  body { margin: 0; min-width: 320px; overflow-x: clip; background-color: var(--paper); background-image: radial-gradient(#1b1b19 0.55px, transparent 0.55px); background-size: 8px 8px; background-blend-mode: soft-light; font: 17px/1.45 var(--display); }
  a { color: inherit; text-decoration: none; }
  img { display: block; max-width: 100%; height: auto; }
  ::selection { background: var(--lemon); color: var(--ink); }
  :focus-visible { outline: 3px solid var(--orange); outline-offset: 4px; }
  .mono, .eyebrow { font: 11px/1.5 var(--mono); text-transform: uppercase; }
  .eyebrow { display: block; }
  .masthead { min-height: 72px; padding: 12px var(--pad); display: flex; justify-content: space-between; align-items: center; gap: 20px; border-bottom: 2px solid var(--ink); background: var(--paper); }
  .logo { display: flex; align-items: center; gap: 11px; font: 700 12px/1 var(--mono); }
  .logo-mark { width: 34px; height: 34px; display: grid; place-items: center; rotate: -7deg; background: var(--lemon); border: 2px solid var(--ink); font: 900 18px/1 var(--display); }
  .logo i { margin-left: 5px; color: var(--muted); font-style: normal; font-size: 9px; }
  .header-right, .languages { display: flex; align-items: center; gap: 14px; }
  .available { display: flex; align-items: center; gap: 7px; font: 10px/1.4 var(--mono); text-transform: uppercase; }
  .available i { width: 9px; height: 9px; border: 2px solid var(--ink); background: var(--cyan); }
  .languages a { padding: 5px 6px; font: 10px/1.4 var(--mono); }
  .languages a[aria-current="page"] { background: var(--ink); color: var(--paper); }
  .ticker { overflow: hidden; border-bottom: 2px solid var(--ink); background: var(--orange); white-space: nowrap; }
  .ticker-track { width: max-content; display: flex; animation: ticker 35s linear infinite; font: 700 10px/1.3 var(--mono); letter-spacing: 0; text-transform: uppercase; }
  .ticker-track span { padding: 8px 0; }
  @keyframes ticker { to { transform: translateX(-50%); } }
  .footer { margin-top: 90px; padding: 24px var(--pad) 18px; border-top: 2px solid var(--ink); background: var(--lemon); }
  .footer-top { display: flex; align-items: center; gap: 28px; min-height: 190px; }
  .footer-stamp { width: 102px; aspect-ratio: 1; display: grid; place-content: center; rotate: 8deg; border: 3px solid var(--ink); border-radius: 50%; background: var(--pink); text-align: center; font: 900 22px/.9 var(--display); }
  .footer-top > div { display: grid; gap: 7px; }
  .footer-cta { font-size: 42px; font-weight: 800; line-height: 1.05; }
  .footer-cta span { color: var(--orange); }
  .footer-bottom { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px 20px; padding-top: 12px; border-top: 1px solid var(--ink); font: 10px/1.5 var(--mono); }
  .footer-bottom > div { display: flex; flex-wrap: wrap; gap: 12px 18px; }
  .footer-bottom a:hover { text-decoration: underline; text-decoration-thickness: 2px; }
  .edition { margin-left: auto; }
  @media (max-width: 640px) {
    :root { --pad: 18px; }
    .masthead { min-height: 62px; }
    .logo { gap: 7px; font-size: 10px; }
    .logo-mark { width: 30px; height: 30px; }
    .logo i { display: none; }
    .header-right { gap: 7px; }
    .available { max-width: 105px; font-size: 9px; }
    .languages { gap: 2px; }
    .footer { margin-top: 64px; }
    .footer-top { min-height: 150px; gap: 18px; }
    .footer-stamp { width: 76px; font-size: 18px; }
    .footer-cta { font-size: 30px; }
  }
  @media (max-width: 390px) {
    .available { display: none; }
    .footer-cta { font-size: 26px; }
    .footer-stamp { width: 64px; }
  }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
  }
</style>