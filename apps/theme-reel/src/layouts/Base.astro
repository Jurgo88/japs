---
import "@fontsource-variable/archivo/wdth.css";
import "@fontsource/jetbrains-mono/400.css";
import { languageName, loadPortfolio } from "@japs/theme-kit";
import { tt } from "../lib/strings.ts";

interface Props {
  locale: string;
  title: string;
  description: string;
  alternates: { locale: string; href: string }[];
  homeHref: string;
}

const { locale, title, description, alternates, homeHref } = Astro.props;
const { profile } = loadPortfolio();
const site = Astro.site;
const initials = profile.name.trim().split(/\s+/).map((part) => part.charAt(0)).join("").slice(0, 2).toUpperCase();
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#0c0a12" />
    {site && alternates.map((a) => <link rel="alternate" hreflang={a.locale} href={new URL(a.href, site).toString()} />)}
    <link rel="icon" href={`data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'><rect width='40' height='40' rx='20' fill='%230c0a12'/><circle cx='20' cy='20' r='13' fill='none' stroke='%23ff4f6d' stroke-width='4'/><circle cx='20' cy='20' r='4' fill='%23ffe98a'/></svg>`} />
  </head>
  <body>
    <header class="masthead">
      <a class="logo" href={homeHref} aria-label={`${profile.name} portfolio`}><span class="logo-mark" aria-hidden="true">{initials}</span><span class="logo-name">{profile.name}</span></a>
      <div class="header-right">
        {profile.available === true && <span class="available"><i aria-hidden="true"></i>{tt(locale, "available")}</span>}
        {alternates.length > 1 && <nav class="languages" aria-label={tt(locale, "language")}>{alternates.map((a) => <a href={a.href} hreflang={a.locale} lang={a.locale} aria-current={a.locale === locale ? "page" : undefined} title={languageName(a.locale)}>{a.locale.toUpperCase()}</a>)}</nav>}
      </div>
    </header>
    <main><slot /></main>
    <footer class="footer">
      <div class="footer-cta">
        <span class="eyebrow">{tt(locale, "contact")}</span>
        {profile.email ? <a href={`mailto:${profile.email}`}>{tt(locale, "reach")} <span aria-hidden="true">→</span></a> : <span>{tt(locale, "reach")}</span>}
      </div>
      <div class="footer-bottom mono">
        <span>© {new Date().getFullYear()} {profile.name}</span>
        <div>{profile.email && <a href={`mailto:${profile.email}`}>{profile.email}</a>}{profile.links.map((link) => <a href={link.url} rel="me noopener">{link.label} ↗</a>)}</div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #0c0a12;
    --bg-2: #15121f;
    --ink: #f3efe7;
    --muted: #9b95a8;
    --line: rgba(243, 239, 231, .14);
    --hot: #ff4f6d;
    --warm: #ffe98a;
    --violet: #6d4bff;
    --display: "Archivo Variable", "Arial Narrow", sans-serif;
    --mono: "JetBrains Mono", ui-monospace, monospace;
    --pad: clamp(16px, 4vw, 48px);
  }
  * { box-sizing: border-box; }
  html { background: var(--bg); color: var(--ink); -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
  body { margin: 0; min-width: 320px; overflow-x: clip; background: radial-gradient(1200px 600px at 50% -10%, #241a4a 0%, transparent 60%), var(--bg); font: 16px/1.5 var(--display); font-stretch: 100%; }
  a { color: inherit; text-decoration: none; }
  img { display: block; max-width: 100%; height: auto; }
  button { font: inherit; color: inherit; }
  ::selection { background: var(--hot); color: var(--bg); }
  :focus-visible { outline: 2px solid var(--warm); outline-offset: 4px; }
  .mono, .eyebrow { font: 11px/1.5 var(--mono); letter-spacing: .04em; text-transform: uppercase; }
  .eyebrow { display: block; color: var(--muted); }
  .masthead { position: relative; z-index: 5; min-height: 68px; padding: 12px var(--pad); display: flex; justify-content: space-between; align-items: center; gap: 16px; border-bottom: 1px solid var(--line); }
  .logo { display: flex; align-items: center; gap: 10px; min-width: 0; font-weight: 600; font-stretch: 112%; }
  .logo-mark { flex: 0 0 auto; width: 34px; height: 34px; display: grid; place-items: center; border-radius: 50%; background: conic-gradient(from 200deg, var(--hot), var(--warm), var(--violet), var(--hot)); color: var(--bg); font: 700 12px/1 var(--mono); }
  .logo-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .header-right, .languages { display: flex; align-items: center; gap: 12px; }
  .available { display: flex; align-items: center; gap: 8px; color: var(--muted); font: 11px/1.4 var(--mono); }
  .available i { width: 8px; height: 8px; border-radius: 50%; background: #5cf2a0; box-shadow: 0 0 10px #5cf2a0; }
  .languages { gap: 2px; }
  .languages a { padding: 5px 7px; border-radius: 999px; color: var(--muted); font: 11px/1.4 var(--mono); }
  .languages a:hover { color: var(--ink); }
  .languages a[aria-current="page"] { background: var(--ink); color: var(--bg); }
  .footer { margin-top: 120px; padding: 48px var(--pad) 22px; border-top: 1px solid var(--line); }
  .footer-cta { display: grid; gap: 10px; padding-bottom: 48px; }
  .footer-cta > a, .footer-cta > span:last-child { max-width: 16ch; font-size: clamp(38px, 7vw, 92px); line-height: .92; font-weight: 800; font-stretch: 125%; }
  .footer-cta a span { color: var(--hot); display: inline-block; transition: translate .25s; }
  .footer-cta a:hover span { translate: 10px 0; }
  .footer-bottom { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px 20px; padding-top: 16px; border-top: 1px solid var(--line); color: var(--muted); }
  .footer-bottom > div { display: flex; flex-wrap: wrap; gap: 10px 18px; }
  .footer-bottom a:hover { color: var(--ink); }
  @media (max-width: 560px) {
    .available { display: none; }
    .footer { margin-top: 80px; }
  }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
  }
</style>
