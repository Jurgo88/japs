---
import { coverShot, loadPortfolio, localePrefix, orderedProjects, plural, portfolioStats, projectUrl, tagCounts, text } from "@japs/theme-kit";
import Base from "../layouts/Base.astro";
import { tt } from "../lib/strings.ts";

interface Props { locale: string }
const { locale } = Astro.props;
const portfolio = loadPortfolio();
const { profile } = portfolio;
const home = (l: string) => `${localePrefix(l, portfolio)}/`;
const projects = orderedProjects(portfolio);
const stats = portfolioStats(portfolio);
const filterTags = tagCounts(portfolio).filter(({ count }) => count < projects.length).slice(0, 8);
const pad = (n: number) => String(n + 1).padStart(2, "0");
const year = (p: (typeof projects)[number]) => (p.period.to ?? p.period.from ?? "").slice(0, 4);
const shotSize = (viewport: string) => (viewport === "mobile" ? { width: 390, height: 844 } : { width: 1440, height: 900 });
---

<Base locale={locale} title={`${profile.name} — ${text(profile.headline, locale)}`} description={text(profile.headline, locale)} alternates={portfolio.locales.map((l) => ({ locale: l, href: home(l) }))} homeHref={home(locale)}>
  <svg class="defs" width="0" height="0" aria-hidden="true" focusable="false">
    <filter id="reel-duotone" color-interpolation-filters="sRGB">
      <feColorMatrix type="matrix" values=".3 .59 .11 0 0  .3 .59 .11 0 0  .3 .59 .11 0 0  0 0 0 1 0" />
      <feComponentTransfer>
        <feFuncR type="table" tableValues="0.078 1 1" />
        <feFuncG type="table" tableValues="0.047 0.31 0.914" />
        <feFuncB type="table" tableValues="0.2 0.427 0.541" />
      </feComponentTransfer>
    </filter>
  </svg>

  <section class="hero">
    <div class="hero-copy">
      <span class="eyebrow">{text(profile.headline, locale)}</span>
      <h1>{profile.name}</h1>
      {text(profile.bio, locale) && <p class="bio">{text(profile.bio, locale)}</p>}
    </div>
    <ul class="hero-stats mono">
      <li><b>{stats.projects}</b>{plural(locale, "projects", stats.projects)}</li>
      <li><b>{stats.technologies}</b>{plural(locale, "technologies", stats.technologies)}</li>
      {stats.years !== null && <li><b>{stats.years}</b>{plural(locale, "years", stats.years)}</li>}
    </ul>
  </section>

  <section class="reel" aria-roledescription="carousel" aria-label={tt(locale, "reel")} data-reel data-pause-label={tt(locale, "pause")} data-play-label={tt(locale, "play")}>
    <div class="reel-stage" data-reel-stage>
      <ol class="reel-ring" data-reel-ring>
        {projects.map((project, i) => {
          const shot = coverShot(project);
          return (
            <li class="reel-slide" data-reel-slide aria-roledescription="slide" aria-label={tt(locale, "slide").replace("{n}", String(i + 1)).replace("{total}", String(projects.length))} data-title={text(project.title, locale)} data-summary={text(project.summary, locale)} data-tags={project.tags.slice(0, 4).join(" · ")} data-href={projectUrl(project, locale, portfolio)}>
              <a href={projectUrl(project, locale, portfolio)}>
                <span class="slide-shot">
                  {shot ? <img src={`/${shot.src}`} alt={text(shot.alt, locale)} loading={i > 3 ? "lazy" : "eager"} draggable="false" {...shotSize(shot.viewport)} /> : <span class="no-shot" aria-hidden="true">{text(project.title, locale).charAt(0)}</span>}
                </span>
                <span class="slide-bar"><span class="mono">{pad(i)}</span><span class="slide-title">{text(project.title, locale)}</span></span>
              </a>
            </li>
          );
        })}
      </ol>
    </div>
    <div class="reel-deck" data-reel-controls hidden>
      <div class="reel-caption" data-reel-caption>
        <span class="eyebrow caption-index">{tt(locale, "nowShowing")} <b data-reel-index>01</b> / {String(projects.length).padStart(2, "0")}</span>
        <a class="caption-title" data-reel-link href={projects[0] ? projectUrl(projects[0], locale, portfolio) : "#"}><span data-reel-title>{projects[0] && text(projects[0].title, locale)}</span><i aria-hidden="true">↗</i></a>
        <p class="caption-summary" data-reel-summary>{projects[0] && text(projects[0].summary, locale)}</p>
        <span class="mono caption-tags" data-reel-tags>{projects[0]?.tags.slice(0, 4).join(" · ")}</span>
      </div>
      <div class="reel-transport">
        <button type="button" class="film film-prev" data-reel-prev aria-label={tt(locale, "previous")}><span class="film-frame" aria-hidden="true"><svg viewBox="0 0 22 12"><path d="M0 0l10 6-10 6zM11 0l10 6-10 6z" /></svg><span class="film-num" data-reel-prev-num>{String(projects.length).padStart(2, "0")}</span></span></button>
        <button type="button" class="pause" data-reel-pause aria-label={tt(locale, "pause")}><span class="i-pause" aria-hidden="true"></span></button>
        <button type="button" class="film" data-reel-next aria-label={tt(locale, "next")}><span class="film-frame" aria-hidden="true"><span class="film-num" data-reel-next-num>02</span><svg viewBox="0 0 22 12"><path d="M0 0l10 6-10 6zM11 0l10 6-10 6z" /></svg></span></button>
      </div>
      <p class="reel-hint mono">{tt(locale, "drag")}</p>
    </div>
  </section>

  <section class="showcase" id="work" aria-labelledby="showcase-title">
    <header class="showcase-head">
      <div><span class="eyebrow">01 —{String(projects.length).padStart(2, "0")}</span><h2 id="showcase-title">{tt(locale, "showcase")}</h2></div>
      {filterTags.length > 0 && (
        <div class="filter" role="group" aria-label={tt(locale, "filter")} data-filter data-showing={tt(locale, "showing")} hidden>
          <button type="button" aria-pressed="true" data-tag="">{tt(locale, "all")}<sup>{projects.length}</sup></button>
          {filterTags.map(({ tag, count }) => <button type="button" aria-pressed="false" data-tag={tag}>{tag}<sup>{count}</sup></button>)}
        </div>
      )}
    </header>
    <p class="filter-status mono" aria-live="polite" data-filter-status></p>
    <ul class="grid">
      {projects.map((project, i) => {
        const shot = coverShot(project);
        return (
          <li class="card" data-card data-tags={JSON.stringify(project.tags)} style={`view-transition-name: reel-card-${i}`}>
            <a href={projectUrl(project, locale, portfolio)}>
              <span class="shot" data-spot>
                {shot ? (
                  <Fragment>
                    <img class="shot-tone" src={`/${shot.src}`} alt={text(shot.alt, locale)} loading="lazy" {...shotSize(shot.viewport)} />
                    <img class="shot-true" src={`/${shot.src}`} alt="" aria-hidden="true" loading="lazy" {...shotSize(shot.viewport)} />
                  </Fragment>
                ) : <span class="no-shot" aria-hidden="true">{text(project.title, locale).charAt(0)}</span>}
                <span class="shot-index mono" aria-hidden="true">{pad(i)}</span>
              </span>
              <span class="card-body">
                <span class="card-meta mono"><span>{project.client.isClient ? tt(locale, "clientWork") : tt(locale, "project")}</span><span>{year(project) || "—"}</span></span>
                <h3>{text(project.title, locale)}</h3>
                <p>{text(project.summary, locale)}</p>
                <span class="card-tags mono">{project.tags.slice(0, 4).map((tag) => <span>{tag}</span>)}</span>
              </span>
            </a>
          </li>
        );
      })}
    </ul>
  </section>
</Base>

<script>
  import "../lib/reel.ts";
</script>

<style>
  .defs { position: absolute; }
  .hero { display: flex; justify-content: space-between; align-items: end; gap: 32px; padding: clamp(40px, 8vw, 96px) var(--pad) 24px; }
  .hero h1 { max-width: 12ch; margin: 10px 0 0; font-size: clamp(48px, 9vw, 132px); line-height: .86; font-weight: 800; font-stretch: 125%; letter-spacing: -.02em; overflow-wrap: anywhere; background: linear-gradient(100deg, var(--ink) 40%, var(--warm) 70%, var(--hot)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .bio { max-width: 52ch; margin: 18px 0 0; color: var(--muted); font-size: 17px; }
  .hero-stats { display: flex; gap: 28px; margin: 0; padding: 0; list-style: none; color: var(--muted); }
  .hero-stats li { display: grid; gap: 2px; }
  .hero-stats b { color: var(--ink); font: 700 34px/1 var(--display); font-stretch: 125%; }

  /* Carousel: a scroll-snap strip without JS, a rotating 3D ring once reel.ts adds .is-3d. */
  .reel { position: relative; padding: 24px 0 0; }
  .reel-stage { --slide-w: clamp(220px, 32vw, 420px); position: relative; }
  .reel-ring { display: flex; gap: 18px; margin: 0; padding: 12px var(--pad) 24px; overflow-x: auto; scroll-snap-type: x mandatory; list-style: none; }
  .reel-slide { flex: 0 0 var(--slide-w); scroll-snap-align: center; }
  .reel-slide a { display: block; overflow: hidden; border: 1px solid var(--line); border-radius: 14px; background: var(--bg-2); box-shadow: 0 30px 60px -30px rgba(0, 0, 0, .8); }
  .slide-shot { position: relative; display: grid; place-items: center; aspect-ratio: 16 / 10; overflow: hidden; background: linear-gradient(135deg, #241a4a, #3a1430); }
  .slide-shot img { width: 100%; height: 100%; object-fit: cover; object-position: top; user-select: none; }
  .no-shot { color: var(--hot); font-size: 96px; font-weight: 800; font-stretch: 125%; }
  .slide-bar { display: flex; align-items: center; gap: 10px; padding: 11px 14px; border-top: 1px solid var(--line); }
  .slide-bar .mono { color: var(--hot); }
  .slide-title { overflow: hidden; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }

  .reel-stage:global(.is-3d) { height: calc(var(--slide-w) * .625 + 46px + 48px + 72px); perspective: 1800px; perspective-origin: 50% 30%; overflow: hidden; cursor: grab; touch-action: pan-y; user-select: none; -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent); mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent); }
  .reel-stage:global(.is-3d.is-dragging) { cursor: grabbing; }
  .reel-stage:global(.is-3d) .reel-ring { position: absolute; top: 48px; left: 50%; width: var(--slide-w); margin-left: calc(var(--slide-w) / -2); padding: 0; overflow: visible; transform-style: preserve-3d; will-change: transform; }
  .reel-stage:global(.is-3d) .reel-slide { position: absolute; inset: 0 auto auto 0; width: 100%; opacity: calc(.18 + .82 * var(--front, 1)); filter: brightness(calc(.35 + .65 * var(--front, 1))) saturate(calc(.3 + .7 * var(--front, 1))); }
  .reel-stage:global(.is-3d) .reel-slide:global(.is-front) a { border-color: rgba(255, 79, 109, .6); box-shadow: 0 0 0 1px rgba(255, 79, 109, .25), 0 40px 80px -30px rgba(255, 79, 109, .45); }
  .reel-stage:global(.is-3d) .reel-slide:global(.is-front) .slide-bar .mono { color: var(--warm); }

  /* Deck under the ring: a fixed-height caption, then one centred transport group, so nothing below ever shifts. */
  .reel-deck { display: grid; justify-items: center; gap: 28px; max-width: 680px; margin: 40px auto 0; padding: 0 var(--pad); text-align: center; }
  .reel-deck[hidden] { display: none; }
  .reel-transport { display: flex; justify-content: center; align-items: center; gap: 12px; }
  /* Film-strip controls: perforated frames; on hover the strip runs in the travel direction and the frame lights up like a projector gate. */
  .film, .pause { --hole: rgba(243, 239, 231, .22); position: relative; height: 60px; display: grid; place-items: center; padding: 11px 6px; border: 0; border-radius: 3px; background: #17121f; box-shadow: inset 0 0 0 1px var(--line); cursor: pointer; overflow: hidden; transition: translate .2s cubic-bezier(.3, 1.6, .5, 1), box-shadow .3s; }
  .film { width: 112px; }
  .film::before, .film::after, .pause::before { position: absolute; left: 0; right: 0; height: 5px; content: ""; background: repeating-linear-gradient(90deg, transparent 0 4px, var(--hole) 4px 9px, transparent 9px 13px); }
  .film::before { top: 3px; }
  .film::after { bottom: 3px; }
  .film-frame { position: relative; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; gap: 9px; border-radius: 2px; background: #0c0a12; box-shadow: inset 0 0 0 1px rgba(243, 239, 231, .08); transition: background .3s, color .3s; }
  .film-frame svg { width: 22px; height: 12px; fill: currentColor; transition: translate .35s cubic-bezier(.7, 0, .2, 1); }
  .film-num { font: 11px/1 var(--mono); letter-spacing: .08em; color: var(--muted); transition: color .3s; }
  .film-prev .film-frame svg { scale: -1 1; }
  .film:hover, .film:focus-visible { --hole: rgba(255, 233, 138, .55); box-shadow: inset 0 0 0 1px rgba(255, 79, 109, .5), 0 0 30px -8px rgba(255, 79, 109, .7); }
  .film:hover::before, .film:hover::after { animation: film-run .32s linear infinite; }
  .film-prev:hover::before, .film-prev:hover::after { animation-direction: reverse; }
  .film:hover .film-frame { background: radial-gradient(circle at 50% 50%, rgba(255, 233, 138, .3), rgba(255, 79, 109, .18) 55%, #0c0a12 100%); color: var(--warm); }
  .film:hover .film-num { color: var(--ink); }
  .film:hover .film-frame svg { translate: 4px 0; }
  .film-prev:hover .film-frame svg { translate: -4px 0; }
  .film:active, .pause:active { translate: 0 2px; }
  @keyframes film-run { to { background-position-x: 13px; } }
  /* Pause: a square frame; the strip along the bottom fills while the reel turns towards the next project. */
  .pause { --progress: 0; width: 60px; }
  .pause::before { top: 3px; }
  .pause::after { position: absolute; left: 6px; bottom: 5px; width: calc((100% - 12px) * var(--progress)); height: 2px; content: ""; background: linear-gradient(90deg, var(--hot), var(--warm)); }
  .pause:hover { box-shadow: inset 0 0 0 1px rgba(243, 239, 231, .35); }
  .i-pause { width: 10px; height: 12px; border-inline: 3px solid currentColor; }
  .pause[aria-pressed="true"] .i-pause { width: 0; height: 0; border-block: 6px solid transparent; border-inline: 10px solid var(--warm); border-inline-end-width: 0; margin-left: 3px; }
  /* Every caption row has a fixed height; long titles, summaries and tag lists are clipped instead of growing. */
  .reel-caption { --title: clamp(26px, 3.4vw, 40px); width: 100%; min-width: 0; display: grid; grid-template-rows: 18px calc(var(--title) * 1.15) calc(2 * 1.5em) 18px; row-gap: 10px; justify-items: center; }
  .caption-index { line-height: 18px; }
  .reel-caption b { color: var(--hot); font-weight: 400; }
  .caption-title { max-width: 100%; display: flex; align-items: flex-start; gap: .2em; font-size: var(--title); line-height: 1.15; font-weight: 800; font-stretch: 118%; }
  .caption-title span { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .caption-title i { flex: 0 0 auto; color: var(--hot); font-style: normal; font-size: .55em; line-height: 1.3; transition: translate .25s; }
  .caption-title:hover span { text-decoration: underline; text-decoration-color: var(--hot); text-decoration-thickness: 2px; text-underline-offset: 5px; }
  .caption-title:hover i { translate: 3px -3px; }
  .caption-summary { max-width: 56ch; margin: 0; overflow: hidden; color: var(--muted); line-height: 1.5; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; line-clamp: 2; }
  .caption-tags { max-width: 100%; overflow: hidden; color: var(--warm); line-height: 18px; text-overflow: ellipsis; white-space: nowrap; }
  .reel-hint { margin: -12px 0 0; color: var(--muted); opacity: .7; }

  /* Showcase: technology filter + duotone screenshots with a pointer spotlight. */
  .showcase { padding: 110px var(--pad) 0; }
  .showcase-head { display: flex; justify-content: space-between; align-items: end; flex-wrap: wrap; gap: 20px; padding-bottom: 18px; border-bottom: 1px solid var(--line); }
  .showcase h2 { margin: 6px 0 0; font-size: clamp(40px, 6vw, 76px); line-height: .9; font-weight: 800; font-stretch: 125%; }
  .filter { display: flex; flex-wrap: wrap; gap: 6px; }
  .filter[hidden] { display: none; }
  .filter button { position: relative; padding: 8px 14px; border: 1px solid var(--line); border-radius: 999px; background: transparent; font: 12px/1.2 var(--mono); cursor: pointer; transition: background .2s, color .2s, border-color .2s; }
  .filter button:hover { border-color: var(--ink); }
  .filter button[aria-pressed="true"] { border-color: transparent; background: linear-gradient(100deg, var(--hot), var(--warm)); color: var(--bg); }
  .filter sup { margin-left: 4px; font-size: 9px; opacity: .65; }
  .filter-status { min-height: 1.5em; margin: 12px 0 0; color: var(--muted); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); gap: 28px 24px; margin: 18px 0 0; padding: 0; list-style: none; }
  .card[hidden] { display: none; }
  .card a { display: grid; gap: 14px; }
  .shot { --spot: 0px; --x: 50%; --y: 50%; position: relative; display: grid; place-items: center; aspect-ratio: 16 / 10; overflow: hidden; border-radius: 12px; background: linear-gradient(135deg, #241a4a, #3a1430); isolation: isolate; }
  .shot img { grid-area: 1 / 1; width: 100%; height: 100%; object-fit: cover; object-position: top; transition: scale .6s cubic-bezier(.2, .7, .2, 1); }
  .shot-tone { filter: url(#reel-duotone) contrast(1.08); }
  .shot-true { position: absolute; inset: 0; clip-path: circle(var(--spot) at var(--x) var(--y)); transition: clip-path .5s cubic-bezier(.2, .7, .2, 1), scale .6s cubic-bezier(.2, .7, .2, 1); }
  .shot::after { position: absolute; inset: 0; z-index: 1; content: ""; pointer-events: none; background: repeating-linear-gradient(0deg, rgba(12, 10, 18, .16) 0 1px, transparent 1px 3px); mix-blend-mode: multiply; transition: opacity .4s; }
  .card a:hover .shot, .card a:focus-visible .shot { --spot: 34%; }
  .card a:focus-visible .shot { --spot: 150%; }
  .card a:hover .shot img { scale: 1.04; }
  .card a:hover .shot::after { opacity: .4; }
  .shot-index { position: absolute; top: 12px; left: 12px; z-index: 2; padding: 4px 8px; border-radius: 999px; background: rgba(12, 10, 18, .7); backdrop-filter: blur(6px); }
  .card-body { display: grid; gap: 6px; }
  .card-meta { display: flex; justify-content: space-between; color: var(--muted); }
  .card h3 { margin: 0; font-size: 28px; line-height: 1.02; font-weight: 700; font-stretch: 115%; overflow-wrap: anywhere; transition: color .2s; }
  .card a:hover h3 { color: var(--warm); }
  .card p { margin: 0; color: var(--muted); }
  .card-tags { display: flex; flex-wrap: wrap; gap: 6px; padding-top: 4px; }
  .card-tags span { padding: 2px 8px; border: 1px solid var(--line); border-radius: 999px; }
  @media (hover: none) {
    .shot-true { display: none; }
  }
  @media (max-width: 700px) {
    .hero { flex-direction: column; align-items: start; }
    .reel-deck { gap: 24px; margin-top: 28px; }
    .reel-caption { grid-template-rows: 18px calc(var(--title) * 1.15) calc(3 * 1.5em) 18px; }
    .caption-summary { -webkit-line-clamp: 3; line-clamp: 3; font-size: 15px; }
    .reel-transport { gap: 8px; }
    .film { width: 96px; }
    .showcase { padding-top: 80px; }
  }
</style>
