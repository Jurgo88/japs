---
import "@fontsource-variable/inter/wght.css";
import { languageName, loadPortfolio } from "@japs/theme-kit";
import { tt } from "../lib/strings.ts";

interface Props {
  locale: string;
  title: string;
  description: string;
  alternates: { locale: string; href: string }[];
  homeHref: string;
  /** Show the zoom controls (the home page canvas). */
  zoom?: boolean;
}

const { locale, title, description, alternates, homeHref, zoom = false } = Astro.props;
const { profile } = loadPortfolio();
const site = Astro.site;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    {site && alternates.map((a) => <link rel="alternate" hreflang={a.locale} href={new URL(a.href, site).toString()} />)}
    <link rel="icon" href={`data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='8' fill='%23111'/><rect x='8' y='8' width='16' height='16' rx='2' fill='none' stroke='%230c8ce9' stroke-width='2.5'/><circle cx='24' cy='24' r='3' fill='%23fff'/></svg>`} />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <header class="toolbar">
      <a class="file" href={homeHref}>
        <span class="logo" aria-hidden="true"></span>
        <span class="file-name">{profile.name}</span>
        <span class="file-sub">/ {tt(locale, "file")}</span>
      </a>
      <span class="tools" aria-hidden="true">
        <svg viewBox="0 0 16 16"><path d="M3 2l9 5-4 1-2 4z" fill="currentColor" /></svg>
        <svg viewBox="0 0 16 16"><path d="M5 1v14M11 1v14M1 5h14M1 11h14" stroke="currentColor" stroke-width="1.5" fill="none" /></svg>
        <svg viewBox="0 0 16 16"><path d="M3 3h10M8 3v10" stroke="currentColor" stroke-width="1.8" fill="none" /></svg>
        <svg viewBox="0 0 16 16"><rect x="2.5" y="2.5" width="11" height="11" rx="2" stroke="currentColor" stroke-width="1.5" fill="none" /></svg>
      </span>
      <span class="right">
        {
          zoom && (
            <span class="zoom" data-zoom hidden>
              <button type="button" data-zoom-out aria-label={tt(locale, "zoomOut")}>−</button>
              <button type="button" class="zoom-value" data-zoom-fit title={tt(locale, "fit")}>
                100%
              </button>
              <button type="button" data-zoom-in aria-label={tt(locale, "zoomIn")}>+</button>
            </span>
          )
        }
        {
          alternates.length > 1 && (
            <nav class="languages" aria-label={tt(locale, "language")}>
              {alternates.map((a) => (
                <a href={a.href} hreflang={a.locale} lang={a.locale} aria-current={a.locale === locale ? "page" : undefined} title={languageName(a.locale)}>
                  {a.locale.toUpperCase()}
                </a>
              ))}
            </nav>
          )
        }
      </span>
    </header>
    <main><slot /></main>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f5f5f4;
    --dot: #d6d6d3;
    --panel: #ffffff;
    --line: #e6e6e3;
    --text: #1e1e1e;
    --muted: #7a7a76;
    --blue: #0c8ce9;
    --sans: "Inter Variable", system-ui, sans-serif;
  }
  * {
    box-sizing: border-box;
  }
  html {
    background: var(--bg);
    color: var(--text);
    -webkit-text-size-adjust: 100%;
  }
  body {
    margin: 0;
    min-width: 320px;
    overflow-x: clip;
    background: var(--bg);
    font: 400 14px/1.5 var(--sans);
  }
  a {
    color: inherit;
  }
  img {
    display: block;
    max-width: 100%;
    height: auto;
  }
  ::selection {
    background: var(--blue);
    color: #fff;
  }
  :focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 2px;
  }
  .dots-bg {
    background-color: var(--bg);
    background-image: radial-gradient(var(--dot) 1px, transparent 1.2px);
    background-size: 24px 24px;
  }

  .toolbar {
    position: sticky;
    top: 0;
    z-index: 50;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 12px;
    height: 48px;
    padding: 0 12px;
    border-bottom: 1px solid var(--line);
    background: var(--panel);
    font-size: 13px;
  }
  .file {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    text-decoration: none;
  }
  .logo {
    flex: none;
    width: 24px;
    height: 24px;
    border-radius: 6px;
    background:
      linear-gradient(var(--blue), var(--blue)) 6px 6px / 12px 12px no-repeat,
      #111;
    box-shadow: inset 0 0 0 9px #111;
  }
  .file-name {
    font-weight: 600;
    white-space: nowrap;
  }
  .file-sub {
    overflow: hidden;
    color: var(--muted);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .tools {
    display: flex;
    gap: 4px;
    padding: 3px;
    border-radius: 8px;
    background: #f0f0ee;
  }
  .tools svg {
    width: 30px;
    height: 26px;
    padding: 5px 7px;
    border-radius: 6px;
    color: var(--text);
  }
  .tools svg:first-child {
    background: var(--blue);
    color: #fff;
  }
  .right {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 12px;
  }
  .zoom {
    display: flex;
    align-items: center;
    border: 1px solid var(--line);
    border-radius: 7px;
  }
  .zoom[hidden] {
    display: none;
  }
  .zoom button {
    min-width: 30px;
    height: 28px;
    padding: 0 6px;
    border: 0;
    background: none;
    color: var(--text);
    font: 500 13px/1 var(--sans);
    cursor: pointer;
  }
  .zoom button:hover {
    background: #f0f0ee;
  }
  .zoom-value {
    min-width: 54px !important;
    border-inline: 1px solid var(--line) !important;
    font-variant-numeric: tabular-nums;
  }
  .languages {
    display: flex;
    gap: 2px;
  }
  .languages a {
    padding: 4px 7px;
    border-radius: 6px;
    color: var(--muted);
    font-size: 12px;
    font-weight: 600;
    text-decoration: none;
  }
  .languages a[aria-current="page"] {
    background: #f0f0ee;
    color: var(--text);
  }
  @media (max-width: 760px) {
    .tools,
    .file-sub {
      display: none;
    }
    .toolbar {
      grid-template-columns: 1fr auto;
    }
  }
</style>
