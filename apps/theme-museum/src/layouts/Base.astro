---
import "@fontsource/instrument-serif/400.css";
import "@fontsource/instrument-serif/400-italic.css";
import "@fontsource-variable/instrument-sans/wght.css";
import { languageName, loadPortfolio } from "@japs/theme-kit";
import { tt } from "../lib/strings.ts";

interface Props {
  locale: string;
  title: string;
  description: string;
  alternates: { locale: string; href: string }[];
  homeHref: string;
}

const { locale, title, description, alternates, homeHref } = Astro.props;
const { profile } = loadPortfolio();
const site = Astro.site;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#f4f2ee" />
    {site && alternates.map((a) => <link rel="alternate" hreflang={a.locale} href={new URL(a.href, site).toString()} />)}
    <link rel="icon" href={`data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect x='3' y='3' width='26' height='26' fill='%23201d1a'/><rect x='8' y='8' width='16' height='16' fill='%23fbfaf6'/><rect x='11' y='11' width='10' height='10' fill='%23b4532a'/></svg>`} />
  </head>
  <body>
    <header class="topbar">
      <a class="wordmark" href={homeHref}>{profile.name}</a>
      <nav class="nav" aria-label={tt(locale, "floorPlan")}>
        <a href={`${homeHref}#rooms`}>{tt(locale, "exhibition")}</a>
        <a href={`${homeHref}#plan`}>{tt(locale, "floorPlan")}</a>
        <a href="#visit">{tt(locale, "visitorInfo")}</a>
      </nav>
      {
        alternates.length > 1 && (
          <nav class="languages" aria-label={tt(locale, "language")}>
            {alternates.map((a) => (
              <a href={a.href} hreflang={a.locale} lang={a.locale} aria-current={a.locale === locale ? "page" : undefined} title={languageName(a.locale)}>
                {a.locale.toUpperCase()}
              </a>
            ))}
          </nav>
        )
      }
    </header>

    <main><slot /></main>

    <footer class="footer" id="visit">
      <h2 class="footer-title">{tt(locale, "visitorInfo")}</h2>
      <div class="info">
        <div>
          <p class="label">{tt(locale, "admission")}</p>
          {
            profile.available !== null && (
              <p class:list={["hours", { closed: !profile.available }]}>{tt(locale, profile.available ? "open" : "closed")}</p>
            )
          }
        </div>
        <div>
          <p class="label">{tt(locale, "enquiries")}</p>
          {profile.email && <a href={`mailto:${profile.email}`}>{profile.email}</a>}
          <ul>
            {profile.links.map((link) => (
              <li>
                <a href={link.url} rel="me noopener">{link.label} ↗</a>
              </li>
            ))}
          </ul>
        </div>
        {
          profile.location && (
            <div>
              <p class="label">{tt(locale, "location")}</p>
              <p>{profile.location}</p>
            </div>
          )
        }
      </div>
      <p class="fine">© {new Date().getFullYear()} {profile.name} · JAPS</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --wall: #f4f2ee;
    --ink: #201d1a;
    --soft: #4f4a43;
    --muted: #8a8378;
    --rule: #d8d2c8;
    --accent: #b4532a;
    --serif: "Instrument Serif", Georgia, serif;
    --sans: "Instrument Sans Variable", system-ui, sans-serif;
    --pad: clamp(18px, 5vw, 72px);
  }
  * {
    box-sizing: border-box;
  }
  html {
    background: var(--wall);
    color: var(--ink);
    -webkit-text-size-adjust: 100%;
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
    min-width: 320px;
    overflow-x: clip;
    background: var(--wall);
    font: 400 16px/1.6 var(--sans);
  }
  a {
    color: inherit;
  }
  img {
    display: block;
    max-width: 100%;
    height: auto;
  }
  ::selection {
    background: var(--accent);
    color: #fff;
  }
  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }
  .label {
    margin: 0;
    color: var(--muted);
    font: 500 12px/1.4 var(--sans);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .topbar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px 32px;
    padding: 22px var(--pad);
    border-bottom: 1px solid var(--rule);
  }
  .topbar a {
    text-decoration: none;
  }
  .wordmark {
    font: 600 14px/1 var(--sans);
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  .nav {
    display: flex;
    gap: 26px;
    color: var(--soft);
    font-size: 14px;
  }
  .nav a:hover,
  .languages a:hover {
    color: var(--accent);
  }
  .languages {
    display: flex;
    gap: 12px;
    margin-left: auto;
    font: 500 12px/1 var(--sans);
    letter-spacing: 0.1em;
  }
  .languages a {
    color: var(--muted);
  }
  .languages a[aria-current="page"] {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .footer {
    margin-top: 140px;
    padding: 56px var(--pad) 32px;
    background: var(--ink);
    color: #ede9e2;
  }
  .footer-title {
    margin: 0;
    font: 400 clamp(32px, 4.4vw, 56px) / 1 var(--serif);
  }
  .info {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 28px 48px;
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid rgb(237 233 226 / 0.2);
  }
  .info p,
  .info ul {
    margin: 8px 0 0;
  }
  .info ul {
    padding: 0;
    list-style: none;
  }
  .info a {
    text-decoration: underline;
    text-decoration-color: rgb(237 233 226 / 0.35);
    text-underline-offset: 4px;
    overflow-wrap: anywhere;
  }
  .info a:hover {
    color: #f0b48e;
  }
  .footer .label {
    color: rgb(237 233 226 / 0.55);
  }
  .hours {
    font: italic 400 22px/1.3 var(--serif);
  }
  .hours.closed {
    color: rgb(237 233 226 / 0.6);
  }
  .fine {
    margin: 48px 0 0;
    color: rgb(237 233 226 / 0.45);
    font-size: 13px;
  }

  @media (max-width: 760px) {
    .nav {
      display: none;
    }
    .footer {
      margin-top: 90px;
    }
  }
</style>
