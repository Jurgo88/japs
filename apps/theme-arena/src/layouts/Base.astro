---
import "@fontsource-variable/archivo/wdth.css";
import "@fontsource/graduate/400.css";
import { languageName, loadPortfolio } from "@japs/theme-kit";
import { tt } from "../lib/strings.ts";

interface Props {
  locale: string;
  title: string;
  description: string;
  alternates: { locale: string; href: string }[];
  homeHref: string;
}

const { locale, title, description, alternates, homeHref } = Astro.props;
const { profile } = loadPortfolio();
const site = Astro.site;
const initials = profile.name
  .trim()
  .split(/\s+/)
  .map((w) => w[0] ?? "")
  .join("")
  .slice(0, 2)
  .toUpperCase();
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#0a0f1f" />
    {site && alternates.map((a) => <link rel="alternate" hreflang={a.locale} href={new URL(a.href, site).toString()} />)}
    <link rel="icon" href={`data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><ellipse cx='16' cy='19' rx='13' ry='6' fill='%23111'/><ellipse cx='16' cy='15' rx='13' ry='6' fill='%23222' stroke='%23d81e3a' stroke-width='1.5'/></svg>`} />
  </head>
  <body>
    <header class="topbar">
      <a class="club" href={homeHref}>
        <svg class="crest" viewBox="0 0 40 46" width="34" height="40" aria-hidden="true">
          <path d="M20 1 38 7v15c0 12-8 19-18 23C10 41 2 34 2 22V7z" fill="#d81e3a" stroke="#fff" stroke-width="2" />
          <path d="M2 17h36v8H2z" fill="#fff" />
          <path d="M2 19h36v4H2z" fill="#1f5fd6" />
          <text x="20" y="38" text-anchor="middle" fill="#fff" font-family="Graduate, serif" font-size="11">{initials}</text>
        </svg>
        <span>{profile.name}</span>
      </a>
      <nav class="nav" aria-label={tt(locale, "roster")}>
        <a href={`${homeHref}#lineup`}>{tt(locale, "lineup")}</a>
        <a href={`${homeHref}#stats`}>{tt(locale, "stats")}</a>
        <a href="#contact">{tt(locale, "contact")}</a>
      </nav>
      {
        alternates.length > 1 && (
          <nav class="languages" aria-label={tt(locale, "language")}>
            {alternates.map((a) => (
              <a href={a.href} hreflang={a.locale} lang={a.locale} aria-current={a.locale === locale ? "page" : undefined} title={languageName(a.locale)}>
                {a.locale.toUpperCase()}
              </a>
            ))}
          </nav>
        )
      }
    </header>

    <main><slot /></main>

    <footer class="footer" id="contact">
      <div class="cta">
        <p class="kicker">{tt(locale, profile.available === false ? "contactUs" : "signMe")}</p>
        {profile.email ? <a class="cta-mail" href={`mailto:${profile.email}`}>{profile.email}</a> : <p class="cta-mail">{profile.name}</p>}
      </div>
      <!-- Dasher boards: link panels like the ads around the rink. -->
      <ul class="boards" aria-label={tt(locale, "sponsors")}>
        {profile.links.map((link) => (
          <li>
            <a href={link.url} rel="me noopener">{link.label}</a>
          </li>
        ))}
        {profile.location && <li class="board-plain">{profile.location}</li>}
        <li class="board-plain">JAPS</li>
      </ul>
      <p class="fine">© {new Date().getFullYear()} {profile.name}</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --night: #0a0f1f;
    --night-2: #131b35;
    --ice: #eef5fa;
    --ice-2: #d9e7f1;
    --text: #0d1426;
    --muted: #64738c;
    --red: #d81e3a;
    --blue: #1f5fd6;
    --led: #ff3d2e;
    --amber: #ffb21a;
    --sport: "Archivo Variable", "Arial Narrow", Arial, sans-serif;
    --jersey: "Graduate", Georgia, serif;
    --pad: clamp(16px, 4vw, 56px);
  }
  * {
    box-sizing: border-box;
  }
  html {
    background: var(--night);
    color: #fff;
    -webkit-text-size-adjust: 100%;
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
    min-width: 320px;
    overflow-x: clip;
    background: var(--night);
    font: 400 16px/1.55 var(--sport);
  }
  a {
    color: inherit;
  }
  img {
    display: block;
    max-width: 100%;
    height: auto;
  }
  ::selection {
    background: var(--red);
    color: #fff;
  }
  :focus-visible {
    outline: 3px solid var(--amber);
    outline-offset: 3px;
  }
  /* Broadcast-style headings: wide, heavy, slanted. */
  .sport {
    font-family: var(--sport);
    font-stretch: 125%;
    font-weight: 900;
    font-style: italic;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }
  .heading {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0 0 28px;
    font: italic 900 clamp(30px, 4.4vw, 60px) / 0.95 var(--sport);
    font-stretch: 125%;
    text-transform: uppercase;
  }
  .heading::before {
    width: 16px;
    height: 0.9em;
    flex: none;
    content: "";
    background: var(--red);
    transform: skewX(-12deg);
  }

  .topbar {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px 28px;
    padding: 10px var(--pad);
    border-bottom: 3px solid var(--red);
    background: rgb(10 15 31 / 0.92);
    backdrop-filter: blur(8px);
  }
  .topbar a {
    text-decoration: none;
  }
  .club {
    display: flex;
    align-items: center;
    gap: 12px;
    font: italic 900 17px/1 var(--sport);
    font-stretch: 115%;
    text-transform: uppercase;
  }
  .nav {
    display: flex;
    gap: 24px;
    font: 800 13px/1 var(--sport);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .nav a,
  .languages a {
    padding: 6px 0 4px;
    border-bottom: 2px solid transparent;
  }
  .nav a:hover,
  .languages a:hover {
    border-color: var(--red);
  }
  .languages {
    display: flex;
    gap: 12px;
    margin-left: auto;
    font: 800 13px/1 var(--sport);
  }
  .languages a {
    color: rgb(255 255 255 / 0.55);
  }
  .languages a[aria-current="page"] {
    color: #fff;
    border-color: #fff;
  }

  .footer {
    margin-top: 120px;
    padding: 64px var(--pad) 28px;
    background:
      radial-gradient(ellipse at 50% 0, rgb(216 30 58 / 0.35), transparent 60%),
      var(--night-2);
    text-align: center;
  }
  .kicker {
    margin: 0;
    color: var(--amber);
    font: 800 14px/1.2 var(--sport);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .cta-mail {
    display: inline-block;
    margin: 14px 0 0;
    font: italic 900 clamp(28px, 5.4vw, 76px) / 1 var(--sport);
    font-stretch: 125%;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  a.cta-mail:hover {
    color: var(--red);
  }
  .boards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    margin: 56px 0 0;
    padding: 0;
    border-radius: 14px;
    overflow: hidden;
    list-style: none;
    /* The yellow kick plate along the bottom of the boards. */
    border-bottom: 8px solid var(--amber);
  }
  .boards li {
    display: grid;
    border-left: 2px solid var(--ice-2);
    background: #fff;
    color: var(--text);
  }
  .boards li:first-child {
    border-left: 0;
  }
  .boards a,
  .board-plain {
    display: grid;
    place-items: center;
    min-height: 64px;
    padding: 10px;
    font: italic 900 20px/1 var(--sport);
    font-stretch: 112%;
    text-transform: uppercase;
    text-decoration: none;
  }
  .boards li:nth-child(3n + 1) a {
    background: var(--red);
    color: #fff;
  }
  .boards li:nth-child(3n + 2) a {
    background: var(--blue);
    color: #fff;
  }
  .boards a:hover {
    filter: brightness(1.15);
  }
  .board-plain {
    color: var(--muted);
  }
  .fine {
    margin: 22px 0 0;
    color: rgb(255 255 255 / 0.5);
    font-size: 13px;
  }

  @media (max-width: 760px) {
    .nav {
      display: none;
    }
    .footer {
      margin-top: 80px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
    }
  }
</style>
