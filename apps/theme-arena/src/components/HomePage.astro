---
import { coverShot, loadPortfolio, localePrefix, orderedProjects, portfolioStats, projectUrl, projectYears, tagCounts, text } from "@japs/theme-kit";
import Base from "../layouts/Base.astro";
import { tt } from "../lib/strings.ts";
import Rink from "./Rink.astro";
import Segments from "./Segments.astro";

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const portfolio = loadPortfolio();
const { profile } = portfolio;
const home = (l: string) => `${localePrefix(l, portfolio)}/`;
const projects = orderedProjects(portfolio);
const stats = portfolioStats(portfolio);
const leaders = tagCounts(portfolio).slice(0, 10);
const present = tt(locale, "present");
const pad = (n: number) => String(n).padStart(2, "0");
const firstName = (profile.name.trim().split(/\s+/)[0] ?? profile.name).toUpperCase();
// Lines of three, like forward lines on a TV lineup graphic.
const lines: (typeof projects)[] = [];
for (let i = 0; i < projects.length; i += 3) lines.push(projects.slice(i, i + 3));
const score = (n: number) => String(Math.min(n, 99));
---

<Base
  locale={locale}
  title={`${profile.name} — ${text(profile.headline, locale)}`}
  description={text(profile.headline, locale)}
  alternates={portfolio.locales.map((l) => ({ locale: l, href: home(l) }))}
  homeHref={home(locale)}
>
  <section class="hero">
    <div class="scoreboard" role="img" aria-label={`${profile.name}: ${stats.projects} ${tt(locale, "projects")}, 0 ${tt(locale, "bugs")}`}>
      <div class="team">
        <span class="team-name">{firstName}</span>
        <Segments value={score(stats.projects).padStart(2, " ")} size={84} class="led-red" />
      </div>
      <div class="center">
        <Segments value="20:00" size={56} class="led-amber clock" />
        <span class="small-label">{tt(locale, "period")}</span>
        <Segments value="3" size={34} class="led-amber" />
      </div>
      <div class="team">
        <span class="team-name">{tt(locale, "bugs")}</span>
        <Segments value=" 0" size={84} class="led-red" />
      </div>
      <div class="board-foot">
        <span><span class="small-label">{tt(locale, "shots")}</span><Segments value={score(stats.technologies)} size={26} class="led-amber" /></span>
        {stats.years !== null && <span><span class="small-label">{tt(locale, "seasons")}</span><Segments value={score(stats.years)} size={26} class="led-amber" /></span>}
      </div>
    </div>

    <div class="intro">
      {
        profile.available !== null && (
          <p class:list={["status", { off: !profile.available }]}>
            <i aria-hidden="true" />
            {tt(locale, profile.available ? "freeAgent" : "underContract")}
            <span>· {tt(locale, profile.available ? "available" : "unavailable")}</span>
          </p>
        )
      }
      <h1 class="name">{profile.name}</h1>
      <p class="headline">{text(profile.headline, locale)}</p>
      {text(profile.bio, locale) && <p class="bio">{text(profile.bio, locale)}</p>}
    </div>
  </section>

  <section class="ice" id="lineup" aria-labelledby="lineup-title">
    <div class="ice-rink" aria-hidden="true"><Rink /></div>
    <h2 id="lineup-title" class="heading">{tt(locale, "lineup")}</h2>
    {
      lines.map((line, li) => (
        <div class="line">
          <p class="line-tag">
            {li + 1}. {tt(locale, "line")}
          </p>
          <ul class="cards">
            {line.map((project, j) => {
              const n = li * 3 + j + 1;
              const shot = coverShot(project);
              return (
                <li>
                  <a class="card" href={projectUrl(project, locale, portfolio)}>
                    <span class="photo">
                      {shot ? (
                        <img src={`/${shot.src}`} alt={text(shot.alt, locale)} loading={n > 3 ? "lazy" : "eager"} width={shot.viewport === "mobile" ? 390 : 1440} height={shot.viewport === "mobile" ? 844 : 900} />
                      ) : (
                        <span class="photo-blank" aria-hidden="true">
                          <Rink />
                        </span>
                      )}
                      <span class="jersey" aria-hidden="true">{n}</span>
                      {project.client.isClient && (
                        <span class="patch" title={tt(locale, "captain")}>
                          C
                        </span>
                      )}
                    </span>
                    <span class="card-body">
                      <span class="card-title">{text(project.title, locale)}</span>
                      <span class="card-meta">
                        <span>#{pad(n)}</span>
                        <span>{projectYears(project, present)}</span>
                        {project.links.live && <span class="live-dot">{tt(locale, "live")}</span>}
                      </span>
                      <span class="card-tags">{project.tags.slice(0, 3).join(" · ") || "—"}</span>
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }
  </section>

  {
    leaders.length > 0 && (
      <section class="stats" id="stats" aria-labelledby="stats-title">
        <h2 id="stats-title" class="heading">{tt(locale, "stats")}</h2>
        <table>
          <thead>
            <tr>
              <th scope="col">#</th>
              <th scope="col">{tt(locale, "stack")}</th>
              <th scope="col" class="num">{tt(locale, "gp")}</th>
              <th scope="col" class="bar-col">{tt(locale, "share")}</th>
            </tr>
          </thead>
          <tbody>
            {leaders.map(({ tag, count }, i) => (
              <tr>
                <td class="rank">{i + 1}</td>
                <td class="player">{tag}</td>
                <td class="num">{count}</td>
                <td class="bar-col">
                  <span class="bar-wrap">
                    <span class="bar">
                      <i style={`width: ${Math.round((count / stats.projects) * 100)}%`} />
                    </span>
                    <span class="pct">{Math.round((count / stats.projects) * 100)}%</span>
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    )
  }
</Base>

<script>
  import { segmentsFor } from "../lib/segments.ts";

  // The game clock counts down a 20-minute period, then starts over.
  const clock = document.querySelector(".clock");
  if (clock && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const digits = [...clock.querySelectorAll<SVGElement>("[data-digit]")];
    let left = 20 * 60;
    const show = (s: number) => {
      const text = `${String(Math.floor(s / 60)).padStart(2, "0")}${String(s % 60).padStart(2, "0")}`;
      digits.forEach((digit, i) => {
        const on = segmentsFor(text[i] ?? " ");
        for (const seg of digit.querySelectorAll<SVGElement>("[data-s]")) seg.classList.toggle("on", on.includes(seg.dataset.s ?? ""));
      });
    };
    setInterval(() => {
      left = left > 0 ? left - 1 : 20 * 60;
      show(left);
    }, 1000);
  }
</script>

<style>
  .hero {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 48px;
    padding: 56px var(--pad) 88px;
    background:
      radial-gradient(ellipse 60% 50% at 50% 0, rgb(255 255 255 / 0.12), transparent 70%),
      radial-gradient(ellipse 40% 60% at 10% 100%, rgb(31 95 214 / 0.25), transparent 70%),
      radial-gradient(ellipse 40% 60% at 90% 100%, rgb(216 30 58 / 0.25), transparent 70%);
    text-align: center;
  }
  .scoreboard {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 18px clamp(18px, 4vw, 56px);
    width: min(100%, 860px);
    padding: 22px clamp(16px, 3vw, 36px) 18px;
    border: 6px solid #232a3f;
    border-radius: 14px;
    background:
      radial-gradient(#1a1d26 1px, transparent 1.2px) 0 0 / 5px 5px,
      #06080e;
    box-shadow:
      0 0 0 2px #000,
      0 30px 80px -30px rgb(0 0 0 / 0.9);
  }
  .team,
  .center {
    display: grid;
    justify-items: center;
    gap: 10px;
  }
  .team-name {
    max-width: 100%;
    overflow: hidden;
    color: #fff;
    font: italic 900 clamp(15px, 2vw, 22px) / 1 var(--sport);
    font-stretch: 120%;
    letter-spacing: 0.04em;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .small-label {
    color: rgb(255 255 255 / 0.65);
    font: 800 11px/1 var(--sport);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .board-foot {
    grid-column: 1 / -1;
    display: flex;
    justify-content: center;
    gap: 40px;
    padding-top: 14px;
    border-top: 1px solid #1d2234;
  }
  .board-foot > span {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .scoreboard :global(.led-red) {
    color: var(--led);
  }
  .scoreboard :global(.led-amber) {
    color: var(--amber);
  }

  .intro {
    display: grid;
    justify-items: center;
    gap: 14px;
    max-width: 900px;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin: 0;
    padding: 7px 14px 5px;
    border-radius: 4px;
    background: var(--red);
    font: 900 13px/1.2 var(--sport);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .status span {
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: none;
  }
  .status i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #fff;
    animation: pulse 1.4s ease-in-out infinite;
  }
  .status.off {
    background: #39415a;
  }
  .status.off i {
    animation: none;
    opacity: 0.6;
  }
  @keyframes pulse {
    50% {
      opacity: 0.25;
    }
  }
  .name {
    margin: 0;
    font: italic 900 clamp(48px, 9vw, 140px) / 0.88 var(--sport);
    font-stretch: 125%;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    overflow-wrap: anywhere;
    text-shadow: 0 6px 0 var(--red);
  }
  .headline {
    margin: 10px 0 0;
    font: 800 clamp(18px, 2vw, 26px) / 1.2 var(--sport);
    font-stretch: 110%;
  }
  .bio {
    max-width: 58ch;
    margin: 0;
    color: rgb(255 255 255 / 0.7);
    font-size: 17px;
  }

  /* The ice: white surface with faint rink markings. */
  .ice {
    position: relative;
    padding: 72px var(--pad) 80px;
    overflow: hidden;
    background: linear-gradient(180deg, #f7fbfe, var(--ice) 40%, #e4eef6);
    color: var(--text);
  }
  .ice-rink {
    position: absolute;
    inset: 40px var(--pad);
    color: var(--ice-2);
    opacity: 0.55;
    pointer-events: none;
  }
  .ice > :not(.ice-rink) {
    position: relative;
  }
  .line {
    display: grid;
    grid-template-columns: 54px minmax(0, 1fr);
    gap: 18px;
    margin-top: 28px;
  }
  .line-tag {
    display: grid;
    place-items: center;
    margin: 0;
    padding: 12px 0;
    border-radius: 6px;
    background: var(--red);
    color: #fff;
    font: italic 900 15px/1 var(--sport);
    font-stretch: 115%;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .card {
    display: grid;
    height: 100%;
    overflow: hidden;
    border-radius: 10px;
    background: #fff;
    box-shadow:
      0 1px 0 var(--ice-2),
      0 18px 40px -26px rgb(13 20 38 / 0.6);
    text-decoration: none;
    transition:
      transform 0.25s,
      box-shadow 0.25s;
  }
  .card:hover,
  .card:focus-visible {
    transform: translateY(-4px);
    box-shadow:
      0 0 0 3px var(--red),
      0 24px 50px -26px rgb(13 20 38 / 0.7);
  }
  .photo {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--night-2);
  }
  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  /* Diagonal jersey stripe across the photo's bottom corner. */
  .photo::after {
    position: absolute;
    left: -10%;
    right: -10%;
    bottom: -38px;
    height: 56px;
    content: "";
    background: linear-gradient(var(--red) 0 45%, #fff 45% 60%, var(--blue) 60%);
    transform: rotate(-4deg);
  }
  .photo-blank {
    position: absolute;
    inset: 14%;
    color: rgb(255 255 255 / 0.35);
  }
  .jersey {
    position: absolute;
    left: 12px;
    top: 8px;
    z-index: 1;
    color: #fff;
    font: 400 clamp(40px, 4.4vw, 64px) / 1 var(--jersey);
    -webkit-text-stroke: 2px var(--text);
    paint-order: stroke fill;
    text-shadow: 3px 3px 0 var(--red);
  }
  .patch {
    position: absolute;
    right: 10px;
    top: 10px;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 2px solid #fff;
    border-radius: 4px;
    background: var(--blue);
    color: #fff;
    font: 400 17px/1 var(--jersey);
  }
  .card-body {
    display: grid;
    align-content: start;
    gap: 6px;
    padding: 14px 16px 16px;
  }
  .card-title {
    font: italic 900 22px/1 var(--sport);
    font-stretch: 115%;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }
  .card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    color: var(--muted);
    font: 800 13px/1.2 var(--sport);
  }
  .live-dot {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--red);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .live-dot::before {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    content: "";
    background: currentColor;
  }
  .card-tags {
    color: var(--text);
    font-size: 14px;
  }

  .stats {
    padding: 88px var(--pad) 0;
  }
  .stats table {
    width: 100%;
    max-width: 980px;
    border-collapse: collapse;
  }
  .stats th {
    padding: 10px 12px;
    border-bottom: 2px solid var(--red);
    color: rgb(255 255 255 / 0.6);
    font: 800 12px/1 var(--sport);
    letter-spacing: 0.14em;
    text-align: left;
    text-transform: uppercase;
  }
  .stats td {
    padding: 11px 12px;
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
  }
  .stats tr:nth-child(odd) td {
    background: rgb(255 255 255 / 0.03);
  }
  .rank {
    width: 3em;
    color: var(--amber);
    font: 400 22px/1 var(--jersey);
  }
  .player {
    font: italic 900 20px/1.1 var(--sport);
    font-stretch: 112%;
    text-transform: uppercase;
  }
  .num {
    width: 4em;
    text-align: right !important;
    font: 900 20px/1 var(--sport);
  }
  .bar-col {
    width: 40%;
  }
  .bar-wrap {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .bar {
    flex: 1;
    height: 10px;
    border-radius: 5px;
    background: rgb(255 255 255 / 0.1);
    overflow: hidden;
  }
  .bar i {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--blue), var(--red));
  }
  .pct {
    width: 3.2em;
    color: rgb(255 255 255 / 0.7);
    font: 800 13px/1 var(--sport);
    text-align: right;
  }

  @media (max-width: 1000px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .hero {
      gap: 36px;
      padding-top: 32px;
    }
    .scoreboard {
      gap: 12px;
      border-width: 4px;
    }
    .scoreboard :global(.segments) {
      --h: 44px !important;
    }
    .center :global(.segments) {
      --h: 30px !important;
    }
    .board-foot :global(.segments) {
      --h: 20px !important;
    }
    .name {
      text-shadow: 0 4px 0 var(--red);
    }
    .line {
      grid-template-columns: minmax(0, 1fr);
      gap: 10px;
    }
    .line-tag {
      justify-self: start;
      padding: 6px 12px 4px;
      writing-mode: horizontal-tb;
      transform: skewX(-10deg);
    }
    .cards {
      grid-template-columns: minmax(0, 1fr);
    }
    .bar-col .bar {
      display: none;
    }
    .bar-col {
      width: auto;
    }
  }
</style>
