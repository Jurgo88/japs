{
  // Hosted JAPS (ADR 0009). Secrets are set with `wrangler secret put`, never committed:
  // GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, NETLIFY_CLIENT_ID, NETLIFY_CLIENT_SECRET,
  // SESSION_SECRET, ENCRYPTION_KEY, OPENAI_API_KEY, GITHUB_BUILD_TOKEN (ADR 0011) and optionally
  // CLOUDFLARE_CLIENT_ID, CLOUDFLARE_CLIENT_SECRET (ADR 0012). For local dev put them in .dev.vars.
  "name": "japs",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // The dashboard (apps/dashboard, built first). Only /api and /auth reach the Worker;
  // everything else is static, with index.html for client-side routes.
  "assets": {
    "directory": "../dashboard/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/builder/*"]
  },
  // japs.app is in the same Cloudflare account; wrangler creates the DNS record and certificate.
  "routes": [{ "pattern": "japs.app", "custom_domain": true }],
  "observability": { "enabled": true },
  "browser": { "binding": "BROWSER" },
  // Own screenshots, under <user id>/<file>. Private: served only through /api/screenshots.
  "r2_buckets": [{ "binding": "SHOTS", "bucket_name": "japs-screenshots" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "japs",
      // Production database (created with `wrangler d1 create japs --location weur`).
      "database_id": "2b2cac86-9e2d-4c82-bd80-d1e58a5324ab",
      "migrations_dir": "migrations"
    }
  ],
  // Background jobs (#32): one import per user, then one instance per project, because the
  // free plan allows 50 external subrequests per instance (ADR 0009).
  "workflows": [
    { "name": "japs-sync", "binding": "SYNC_JOBS", "class_name": "SyncWorkflow" },
    { "name": "japs-project", "binding": "PROJECT_JOBS", "class_name": "ProjectWorkflow" },
    // Screenshots (#33): one run per user, sequential, paced to the Browser Run limits.
    { "name": "japs-screenshots", "binding": "SHOT_JOBS", "class_name": "ScreenshotWorkflow" }
  ],
  "vars": {
    // Public URL of the app, used for OAuth redirect URIs. Local dev overrides it in .dev.vars.
    "APP_URL": "https://japs.app",
    // GitHub App URL slug (github.com/apps/<slug>), for "install on your repositories".
    "GITHUB_APP_SLUG": "japs-portfolio",
    "JAPS_LLM_MODEL": "gpt-5-mini",
    // AI generations per user and month on the shared key; then the user adds an own key.
    "JAPS_FREE_GENERATIONS": "50",
    // Where the publish workflow lives (ADR 0011); its token is the secret GITHUB_BUILD_TOKEN.
    "JAPS_BUILD_REPO": "Jurgo88/japs"
  }
}
