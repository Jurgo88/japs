---
/** Pixel-style desktop icons, drawn on a 32×32 grid. */
interface Props {
  kind: "folder" | "doc" | "tools" | "mail" | "trash" | "computer";
  size?: number;
}

const { kind, size = 40 } = Astro.props;
---

<svg class="icon" viewBox="0 0 32 32" width={size} height={size} shape-rendering="crispEdges" aria-hidden="true">
  {
    kind === "folder" && (
      <>
        <path d="M2.5 7.5h10l3 3h14v18h-27z" fill="#a9b8ff" stroke="#000" />
        <path d="M2.5 12.5h27" stroke="#000" />
        <path d="M3 13h26v1H3z" fill="#d6ddff" />
      </>
    )
  }
  {
    kind === "doc" && (
      <>
        <path d="M6.5 2.5h14l6 6v21h-20z" fill="#fff" stroke="#000" />
        <path d="M20.5 2.5v6h6" fill="#ccc" stroke="#000" />
        <path d="M10 13h13M10 17h13M10 21h13M10 25h8" stroke="#000" />
      </>
    )
  }
  {
    kind === "tools" && (
      <>
        <path d="M3.5 5.5h25v21h-25z" fill="#ddd" stroke="#000" />
        <path d="M9.5 9v14M16.5 9v14M23.5 9v14" stroke="#555" />
        <path d="M7.5 17.5h4v3h-4z" fill="#ff5c5c" stroke="#000" />
        <path d="M14.5 11.5h4v3h-4z" fill="#ffd34d" stroke="#000" />
        <path d="M21.5 15.5h4v3h-4z" fill="#5cd67a" stroke="#000" />
      </>
    )
  }
  {
    kind === "mail" && (
      <>
        <path d="M3.5 8.5h25v16h-25z" fill="#fff" stroke="#000" />
        <path d="M3.5 8.5l12.5 9.5 12.5-9.5" fill="none" stroke="#000" />
        <path d="M22 11h4v4h-4z" fill="#ff5c5c" />
      </>
    )
  }
  {
    kind === "trash" && (
      <>
        <path d="M8.5 9.5h15l-2 20h-11z" fill="#ccc" stroke="#000" />
        <path d="M5.5 6.5h21v3h-21z" fill="#e6e6e6" stroke="#000" />
        <path d="M13.5 3.5h5v3h-5z" fill="#e6e6e6" stroke="#000" />
        <path d="M12.5 12v15M16 12v15M19.5 12v15" stroke="#777" />
      </>
    )
  }
  {
    kind === "computer" && (
      <>
        <path d="M5.5 2.5h21v22h-21z" fill="#e6e6e6" stroke="#000" />
        <path d="M8.5 5.5h15v11h-15z" fill="#5f6fc2" stroke="#000" />
        <path d="M13 9h1v2h-1zM18 9h1v2h-1zM12 12h1v1h-1zM19 12h1v1h-1zM13 13h6v1h-6z" fill="#fff" />
        <path d="M7.5 26.5h17v3h-17z" fill="#ccc" stroke="#000" />
        <path d="M19 20h4v1h-4z" fill="#000" />
      </>
    )
  }
</svg>
