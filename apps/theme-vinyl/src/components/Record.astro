---
/**
 * A vinyl record: grooves, a sheen and a centre label. The label shows an image (a project's
 * screenshot) or plain text. Spinning is controlled by the parent with the `spin` class.
 */
interface Props {
  image?: string;
  labelText?: string;
  class?: string;
}

const { image, labelText, class: className } = Astro.props;
---

<span class:list={["record", className]} aria-hidden="true">
  <span class="disc">
    <span class="label">
      {image ? <img src={image} alt="" loading="lazy" /> : <span class="label-text">{labelText}</span>}
      <i class="hole"></i>
    </span>
  </span>
</span>

<style>
  .record {
    display: block;
    aspect-ratio: 1;
  }
  .disc {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background:
      conic-gradient(from 30deg, transparent 0 8%, rgb(255 255 255 / 0.13) 12%, transparent 18% 50%, rgb(255 255 255 / 0.09) 58%, transparent 64%),
      repeating-radial-gradient(circle, #111 0 1.5px, #1d1d1d 2px 3px),
      #121212;
    box-shadow:
      0 0 0 1px #000,
      0 18px 40px -16px rgb(0 0 0 / 0.6);
  }
  .label {
    position: relative;
    display: grid;
    place-items: center;
    width: 34%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 50%;
    background: var(--orange);
    box-shadow: 0 0 0 4px #0b0b0b;
  }
  .label img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .label-text {
    padding: 12%;
    color: var(--cream);
    font: 700 clamp(8px, 1.1vw, 14px) / 1.1 var(--display);
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .hole {
    position: absolute;
    width: 9%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--cream);
    box-shadow: inset 0 1px 2px rgb(0 0 0 / 0.5);
  }
  :global(.spin) .disc {
    animation: spin 1.8s linear infinite;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.spin) .disc {
      animation: none;
    }
  }
</style>
