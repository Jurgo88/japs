---
import ProjectPage from "../../../components/ProjectPage.astro";
import { loadPortfolio } from "@japs/theme-kit";

export function getStaticPaths() {
  const portfolio = loadPortfolio();
  return portfolio.locales.filter((locale) => locale !== portfolio.defaultLocale).flatMap((locale) =>
    portfolio.projects.map((project) => ({ params: { locale, slug: project.slug }, props: { project } })),
  );
}

const { locale } = Astro.params;
const { project } = Astro.props;
---

<ProjectPage project={project} locale={locale!} />