---
import type { PortfolioProject } from "@japs/schema";
import { formatMonth, loadPortfolio, localePrefix, neighbours, orderedProjects, projectUrl, renderMarkdown, text } from "@japs/theme-kit";
import Base from "../layouts/Base.astro";
import { tt } from "../lib/strings.ts";

interface Props {
  project: PortfolioProject;
  locale: string;
}

const { project, locale } = Astro.props;
const portfolio = loadPortfolio();
const title = text(project.title, locale);
const ordered = orderedProjects(portfolio);
const index = ordered.findIndex((p) => p.slug === project.slug);
const pad = (n: number) => String(n).padStart(2, "0");
const from = formatMonth(project.period.from, locale);
const to = formatMonth(project.period.to, locale) ?? tt(locale, "present");
const period = from ? `${from} – ${to}` : to;
const desktop = project.screenshots.find((s) => s.viewport === "desktop");
const mobile = project.screenshots.find((s) => s.viewport === "mobile");
const home = `${localePrefix(locale, portfolio)}/`;
// The last project leads back to the first one.
const next = neighbours(project, portfolio).next ?? (ordered.length > 1 ? ordered[0] : null);
const facts: [string, string][] = [
  [tt(locale, "role"), project.role ? text(project.role, locale) : "—"],
  [tt(locale, "period"), period],
  [tt(locale, "stack"), project.tags.join(", ") || "—"],
];
if (project.client.isClient) facts.push([tt(locale, "clientWork"), project.client.label ? text(project.client.label, locale) : "—"]);
---

<Base
  locale={locale}
  title={`${title} — ${portfolio.profile.name}`}
  description={text(project.summary, locale)}
  alternates={portfolio.locales.map((l) => ({ locale: l, href: projectUrl(project, l, portfolio) }))}
  homeHref={home}
>
  <article>
    <header class="head grid">
      <div class="crumbs label">
        <a href={`${home}#work`}>← {tt(locale, "back")}</a>
        <span>{tt(locale, "no")} {pad(index + 1)} / {pad(ordered.length)}</span>
      </div>
      <span class="no" aria-hidden="true">{pad(index + 1)}</span>
      <h1>{title}</h1>
      <p class="summary">{text(project.summary, locale)}</p>
    </header>

    <dl class="facts grid">
      {
        facts.map(([label, value]) => (
          <div>
            <dt class="label">{label}</dt>
            <dd>{value}</dd>
          </div>
        ))
      }
    </dl>

    {
      (desktop || mobile) && (
        <div class:list={["devices grid", { "with-phone": desktop && mobile }]}>
          {desktop && (
            <figure class="shot">
              <img src={`/${desktop.src}`} alt={text(desktop.alt, locale)} width="1440" height="900" />
            </figure>
          )}
          {mobile && (
            <figure class="phone">
              <img src={`/${mobile.src}`} alt={text(mobile.alt, locale)} width="390" height="844" />
            </figure>
          )}
        </div>
      )
    }

    <div class="body grid">
      <div class="description" set:html={renderMarkdown(text(project.description, locale))} />
      {
        (project.links.live || project.links.repo) && (
          <ul class="links">
            {project.links.live && (
              <li>
                <a href={project.links.live} rel="noopener">{tt(locale, "live")} ↗</a>
              </li>
            )}
            {project.links.repo && (
              <li>
                <a href={project.links.repo} rel="noopener">{tt(locale, "source")} ↗</a>
              </li>
            )}
          </ul>
        )
      }
    </div>

    {
      next && (
        <a class="next grid" href={projectUrl(next, locale, portfolio)}>
          <span class="label">{tt(locale, "next")} → {pad(ordered.indexOf(next) + 1)}</span>
          <span class="next-title">{text(next.title, locale)}</span>
        </a>
      )
    }
  </article>
</Base>

<style>
  .head {
    row-gap: 24px;
    padding-block: 28px 64px;
    align-items: start;
  }
  .crumbs {
    grid-column: 1 / -1;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    color: var(--muted);
  }
  .crumbs a:hover {
    color: var(--red);
  }
  .no {
    grid-column: 1 / span 3;
    grid-row: 2 / span 2;
    color: var(--red);
    font-size: clamp(64px, 10vw, 180px);
    font-weight: 700;
    line-height: 0.8;
    letter-spacing: -0.06em;
  }
  h1 {
    grid-column: 4 / -1;
    margin: 0;
    font-size: clamp(52px, 9vw, 168px);
    font-weight: 700;
    line-height: 0.86;
    letter-spacing: -0.055em;
    overflow-wrap: anywhere;
  }
  .summary {
    grid-column: 4 / span 6;
    margin: 0;
    font-size: clamp(20px, 1.9vw, 28px);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .facts {
    margin: 0;
  }
  .facts div {
    grid-column: span 3;
    display: grid;
    align-content: start;
    gap: 6px;
    padding-block: 12px 28px;
    border-top: 1px solid var(--line);
  }
  .facts dt {
    color: var(--muted);
  }
  .facts dd {
    margin: 0;
    font-size: 17px;
    line-height: 1.35;
  }

  .devices {
    row-gap: var(--gap);
    margin-top: 24px;
  }
  .devices > * {
    grid-column: 1 / -1;
  }
  /* Desktop takes nine columns, the phone three: at 16:10 vs 390:844 their heights come out close; the shot sets the row height. */
  .devices.with-phone .shot {
    grid-column: 1 / span 9;
  }
  .devices.with-phone .phone {
    grid-column: 10 / -1;
  }
  .shot,
  .phone {
    margin: 0;
    overflow: hidden;
    background: var(--ink);
  }
  .shot img {
    width: 100%;
    height: auto;
  }
  .phone {
    position: relative;
    min-height: 0;
  }
  .devices:not(.with-phone) .phone {
    grid-column: 5 / span 4;
    aspect-ratio: 390 / 844;
  }
  /* Out of flow so the phone never stretches the row. */
  .phone img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .body {
    row-gap: 32px;
    padding-top: 80px;
    align-items: start;
  }
  .description {
    grid-column: 4 / span 6;
    font-size: 19px;
    line-height: 1.55;
  }
  .description > :global(:first-child) {
    margin-top: 0;
  }
  .description > :global(p:first-child) {
    font-size: 1.4em;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }
  .description :global(h2),
  .description :global(h3) {
    margin: 1.8em 0 0.5em;
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }
  .description :global(h2) {
    font-size: 32px;
  }
  .description :global(h3) {
    font-size: 24px;
  }
  .description :global(a) {
    color: var(--red);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .description :global(ul),
  .description :global(ol) {
    padding-left: 1.2em;
  }
  .description :global(li::marker) {
    color: var(--red);
  }
  .links {
    grid-column: 10 / -1;
    position: sticky;
    top: 90px;
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .links a {
    display: block;
    padding: 12px 0;
    border-top: 1px solid var(--line);
    font-size: 17px;
    font-weight: 600;
  }
  .links li:last-child a {
    border-bottom: 1px solid var(--line);
  }
  .links a:hover {
    color: var(--red);
  }

  .next {
    row-gap: 18px;
    margin-top: 140px;
    padding-block: 18px 40px;
    background: var(--ink);
    color: var(--paper);
    transition: background 0.25s;
  }
  .next .label {
    grid-column: 1 / -1;
  }
  .next-title {
    grid-column: 4 / -1;
    font-size: clamp(44px, 7vw, 128px);
    font-weight: 700;
    line-height: 0.88;
    letter-spacing: -0.055em;
    overflow-wrap: anywhere;
  }
  /* The contact footer follows straight after the dark band. */
  :global(body:has(.next) .footer) {
    margin-top: 0;
  }
  .next:hover,
  .next:focus-visible {
    background: var(--red);
  }

  @media (max-width: 1000px) {
    .facts div {
      grid-column: span 6;
    }
    .description {
      grid-column: 4 / -1;
    }
    .links {
      grid-column: 4 / -1;
      position: static;
    }
  }
  @media (max-width: 760px) {
    .head {
      padding-block: 18px 40px;
      row-gap: 18px;
    }
    .no {
      grid-column: 1 / -1;
      grid-row: auto;
      font-size: 64px;
    }
    h1,
    .summary {
      grid-column: 1 / -1;
    }
    .devices.with-phone .shot {
      grid-column: 1 / span 9;
    }
    .devices.with-phone .phone {
      grid-column: 10 / -1;
    }
    .devices:not(.with-phone) .phone {
      grid-column: 3 / span 8;
    }
    .body {
      padding-top: 48px;
      row-gap: 24px;
    }
    .description,
    .links {
      grid-column: 1 / -1;
    }
    .description {
      font-size: 17px;
    }
    .next {
      margin-top: 90px;
    }
    .next-title {
      grid-column: 1 / -1;
    }
  }
</style>
