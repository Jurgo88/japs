---
import "@fontsource/barlow-condensed/500.css";
import "@fontsource/barlow-condensed/600.css";
import "@fontsource/barlow-condensed/700.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource-variable/caveat/wght.css";
import { languageName, loadPortfolio, text } from "@japs/theme-kit";
import { tt } from "../lib/strings.ts";

interface Props {
  locale: string;
  title: string;
  description: string;
  alternates: { locale: string; href: string }[];
  homeHref: string;
  /** Sheet number for the title block, e.g. "A-000" or "P-06". */
  sheet: string;
  sheetTitle: string;
  next?: { href: string; label: string } | null;
}

const { locale, title, description, alternates, homeHref, sheet, sheetTitle, next } = Astro.props;
const portfolio = loadPortfolio();
const { profile } = portfolio;
const site = Astro.site;
const date = new Intl.DateTimeFormat(locale, { year: "numeric", month: "2-digit", day: "2-digit", timeZone: "UTC" }).format(new Date(portfolio.generatedAt));
const zones = Array.from({ length: 8 }, (_, i) => i + 1);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#13457f" />
    {site && alternates.map((a) => <link rel="alternate" hreflang={a.locale} href={new URL(a.href, site).toString()} />)}
    <link rel="icon" href={`data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' fill='%2313457f'/><circle cx='16' cy='16' r='11' fill='none' stroke='%23e8f1ff' stroke-width='2'/><path d='M5 16h22' stroke='%23e8f1ff' stroke-width='2'/></svg>`} />
    <script is:inline>
      document.documentElement.classList.add("js");
      try {
        if (localStorage.getItem("japs-blueprint-view") === "photo") document.documentElement.dataset.view = "photo";
      } catch {}
    </script>
  </head>
  <body>
    <div class="sheet">
      <ol class="zones" aria-hidden="true">{zones.map((z) => <li>{z}</li>)}</ol>

      <header class="strip">
        <a class="brand" href={homeHref}>
          <b>{profile.name}</b>
          <span>{tt(locale, "drawingSet")} · {sheet}</span>
        </a>
        <nav class="nav" aria-label={tt(locale, "index")}>
          <a href={`${homeHref}#index`}>{tt(locale, "index")}</a>
          <a href="#contact">{tt(locale, "contact")}</a>
        </nav>
        <div class="controls">
          <div class="view-toggle" role="group" aria-label={tt(locale, "view")}>
            <button type="button" data-view="line" aria-pressed="true">{tt(locale, "viewLine")}</button>
            <button type="button" data-view="photo" aria-pressed="false">{tt(locale, "viewPhoto")}</button>
          </div>
          {
            alternates.length > 1 && (
              <nav class="languages" aria-label={tt(locale, "language")}>
                {alternates.map((a) => (
                  <a href={a.href} hreflang={a.locale} lang={a.locale} aria-current={a.locale === locale ? "page" : undefined} title={languageName(a.locale)}>
                    {a.locale.toUpperCase()}
                  </a>
                ))}
              </nav>
            )
          }
        </div>
      </header>

      <main><slot /></main>

      <footer class="titleblock" id="contact">
        <div class="cell drawn">
          <span class="label">{tt(locale, "drawnBy")}</span>
          <strong>{profile.name}</strong>
          <span class="muted">{text(profile.headline, locale)}</span>
          <ul>
            {profile.email && (
              <li>
                <a href={`mailto:${profile.email}`}>{profile.email}</a>
              </li>
            )}
            {profile.links.map((link) => (
              <li>
                <a href={link.url} rel="me noopener">{link.label} ↗</a>
              </li>
            ))}
          </ul>
        </div>
        <div class="cell name">
          <span class="label">{tt(locale, "title")}</span>
          <strong>{sheetTitle}</strong>
        </div>
        <div class="cell date">
          <span class="label">{tt(locale, "date")}</span>
          <span>{date}</span>
        </div>
        <div class="cell set">
          <span class="label">{tt(locale, "checked")}</span>
          <span>JAPS</span>
        </div>
        <div class="cell scale">
          <span class="label">{tt(locale, "scale")}</span>
          <span>1 : 1</span>
        </div>
        <div class="cell next">
          <span class="label">{tt(locale, "nextSheet")}</span>
          {next ? <a href={next.href}>{next.label} →</a> : <span>—</span>}
        </div>
        <div class="cell no">
          <span class="label">{tt(locale, "sheet")}</span>
          <strong>{sheet}</strong>
        </div>
      </footer>

      <ol class="zones bottom" aria-hidden="true">{zones.map((z) => <li>{z}</li>)}</ol>
    </div>

    <script>
      const root = document.documentElement;
      const buttons = document.querySelectorAll<HTMLButtonElement>(".view-toggle button");
      const sync = () => {
        const view = root.dataset.view === "photo" ? "photo" : "line";
        for (const b of buttons) b.setAttribute("aria-pressed", String(b.dataset.view === view));
      };
      sync();
      for (const b of buttons) {
        b.addEventListener("click", () => {
          if (b.dataset.view === "photo") root.dataset.view = "photo";
          else delete root.dataset.view;
          try {
            localStorage.setItem("japs-blueprint-view", b.dataset.view ?? "line");
          } catch {}
          sync();
        });
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --paper: #13457f;
    --paper-deep: #0e3766;
    --line: #e8f1ff;
    --soft: rgb(232 241 255 / 0.68);
    --faint: rgb(232 241 255 / 0.16);
    --red: #ff7a5c;
    --display: "Barlow Condensed", "Arial Narrow", sans-serif;
    --mono: "IBM Plex Mono", ui-monospace, monospace;
    --hand: "Caveat Variable", "Comic Sans MS", cursive;
    --pad: 28px;
  }
  * {
    box-sizing: border-box;
  }
  html {
    background: var(--paper);
    color: var(--line);
    -webkit-text-size-adjust: 100%;
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
    min-width: 320px;
    padding: 14px;
    overflow-x: clip;
    background-color: var(--paper);
    background-image:
      linear-gradient(var(--faint) 1px, transparent 1px),
      linear-gradient(90deg, var(--faint) 1px, transparent 1px),
      linear-gradient(rgb(232 241 255 / 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgb(232 241 255 / 0.06) 1px, transparent 1px);
    background-size:
      48px 48px,
      48px 48px,
      8px 8px,
      8px 8px;
    font: 400 15px/1.6 var(--mono);
  }
  a {
    color: inherit;
  }
  img {
    display: block;
    max-width: 100%;
    height: auto;
  }
  ::selection {
    background: var(--line);
    color: var(--paper);
  }
  :focus-visible {
    outline: 2px dashed var(--red);
    outline-offset: 3px;
  }
  .label {
    display: block;
    color: var(--soft);
    font: 500 11px/1.3 var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .muted {
    color: var(--soft);
  }
  .hand {
    color: var(--red);
    font-family: var(--hand);
    font-weight: 600;
    line-height: 1;
  }

  /* The drawing frame: a heavy border with a thin second line inside. */
  .sheet {
    position: relative;
    max-width: 1500px;
    margin: 0 auto;
    border: 2px solid var(--line);
    outline: 1px solid var(--line);
    outline-offset: -8px;
    background: rgb(19 69 127 / 0.55);
  }
  .zones {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    margin: 0;
    padding: 0 8px;
    list-style: none;
    font: 500 10px/1 var(--mono);
    color: var(--soft);
  }
  .zones li {
    padding: 10px 0 0;
    border-left: 1px solid var(--faint);
    text-align: center;
  }
  .zones li:first-child {
    border-left: 0;
  }
  .zones.bottom li {
    padding: 0 0 10px;
  }

  .strip {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px 28px;
    margin: 6px var(--pad) 0;
    padding: 10px 0;
    border-block: 1px solid var(--line);
    font: 500 12px/1.3 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .strip a {
    text-decoration: none;
  }
  .brand {
    display: grid;
  }
  .brand b {
    font: 700 19px/1 var(--display);
    letter-spacing: 0.06em;
  }
  .brand span {
    color: var(--soft);
    font-size: 11px;
  }
  .nav {
    display: flex;
    gap: 22px;
  }
  .nav a:hover,
  .languages a:hover {
    color: var(--red);
  }
  .controls {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-left: auto;
  }
  .view-toggle {
    display: none;
    border: 1px solid var(--line);
  }
  .js .view-toggle {
    display: flex;
  }
  .view-toggle button {
    padding: 5px 10px;
    border: 0;
    background: none;
    color: var(--line);
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    cursor: pointer;
  }
  .view-toggle button[aria-pressed="true"] {
    background: var(--line);
    color: var(--paper);
  }
  .languages {
    display: flex;
    gap: 10px;
  }
  .languages a {
    color: var(--soft);
  }
  .languages a[aria-current="page"] {
    color: var(--line);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  main {
    padding: 0 var(--pad);
  }

  /* Screenshots as blueprints: inverted greyscale screened onto the paper; the photo shows on hover or in Photo view. */
  .plate {
    position: relative;
    margin: 0;
    overflow: hidden;
    background: var(--paper-deep);
    outline: 1px solid var(--line);
  }
  .plate img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    filter: grayscale(1) invert(1) contrast(1.35) brightness(1.05);
    mix-blend-mode: screen;
  }
  .plate:hover img,
  [data-view="photo"] .plate img {
    filter: none;
    mix-blend-mode: normal;
  }
  /* Crop marks at the corners. */
  .plate::after {
    position: absolute;
    inset: 6px;
    content: "";
    pointer-events: none;
    background:
      linear-gradient(var(--line), var(--line)) left top / 14px 1px no-repeat,
      linear-gradient(var(--line), var(--line)) left top / 1px 14px no-repeat,
      linear-gradient(var(--line), var(--line)) right top / 14px 1px no-repeat,
      linear-gradient(var(--line), var(--line)) right top / 1px 14px no-repeat,
      linear-gradient(var(--line), var(--line)) left bottom / 14px 1px no-repeat,
      linear-gradient(var(--line), var(--line)) left bottom / 1px 14px no-repeat,
      linear-gradient(var(--line), var(--line)) right bottom / 14px 1px no-repeat,
      linear-gradient(var(--line), var(--line)) right bottom / 1px 14px no-repeat;
    mix-blend-mode: difference;
  }
  /* Hatched placeholder when a project has no screenshot. */
  .hatch {
    display: grid;
    place-items: center;
    height: 100%;
    padding: 12px;
    background: repeating-linear-gradient(45deg, var(--faint) 0 1px, transparent 1px 9px);
    color: var(--soft);
    font: 500 11px/1.4 var(--mono);
    letter-spacing: 0.12em;
    text-align: center;
    text-transform: uppercase;
  }

  /* Title block */
  .titleblock {
    display: grid;
    grid-template-columns: 2.2fr 2fr 1fr 1fr 1.1fr;
    grid-template-areas:
      "drawn name name date no"
      "drawn set scale next no";
    margin: 110px var(--pad) 6px;
    border: 2px solid var(--line);
  }
  .cell {
    display: grid;
    align-content: start;
    gap: 6px;
    padding: 10px 12px 12px;
    border: 1px solid var(--line);
    font-size: 13px;
    overflow-wrap: anywhere;
  }
  .cell strong {
    font: 700 24px/1 var(--display);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .drawn {
    grid-area: drawn;
  }
  .drawn strong {
    font-size: 30px;
  }
  .drawn ul {
    display: grid;
    gap: 2px;
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
  }
  .drawn a,
  .next a {
    text-decoration: underline;
    text-decoration-color: var(--soft);
    text-underline-offset: 3px;
  }
  .drawn a:hover,
  .next a:hover {
    color: var(--red);
  }
  .name {
    grid-area: name;
  }
  .date {
    grid-area: date;
  }
  .set {
    grid-area: set;
  }
  .scale {
    grid-area: scale;
  }
  .next {
    grid-area: next;
  }
  .no {
    grid-area: no;
    align-content: space-between;
  }
  .no strong {
    font-size: clamp(40px, 5vw, 72px);
    line-height: 0.9;
  }

  @media (max-width: 860px) {
    :root {
      --pad: 16px;
    }
    body {
      padding: 6px;
    }
    .nav {
      display: none;
    }
    .controls {
      gap: 10px;
    }
    .titleblock {
      grid-template-columns: 1fr 1fr;
      grid-template-areas:
        "drawn drawn"
        "name name"
        "date scale"
        "set next"
        "no no";
      margin-top: 72px;
    }
  }
  @media (max-width: 480px) {
    .brand span {
      display: none;
    }
    .strip {
      gap: 10px 14px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
    }
  }
</style>
