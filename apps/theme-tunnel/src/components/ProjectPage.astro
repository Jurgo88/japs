---
import type { PortfolioProject } from "@japs/schema";
import { coverShot, formatMonth, loadPortfolio, localePrefix, neighbours, orderedProjects, projectUrl, renderMarkdown, text } from "@japs/theme-kit";
import Base from "../layouts/Base.astro";
import { tt } from "../lib/strings.ts";

interface Props {
  project: PortfolioProject;
  locale: string;
}

const { project, locale } = Astro.props;
const portfolio = loadPortfolio();
const title = text(project.title, locale);
const ordered = orderedProjects(portfolio);
const index = ordered.findIndex((p) => p.slug === project.slug);
const from = formatMonth(project.period.from, locale);
const to = formatMonth(project.period.to, locale) ?? tt(locale, "present");
const period = from ? `${from} – ${to}` : to;
const desktop = project.screenshots.find((s) => s.viewport === "desktop");
const mobile = project.screenshots.find((s) => s.viewport === "mobile");
const home = `${localePrefix(locale, portfolio)}/`;
// The last destination leads back to the first one.
const next = neighbours(project, portfolio).next ?? (ordered.length > 1 ? ordered[0]! : null);
const nextShot = next ? coverShot(next) : undefined;
const pad = (n: number) => String(n).padStart(2, "0");
const facts: [string, string][] = [
  [tt(locale, "role"), project.role ? text(project.role, locale) : "—"],
  [tt(locale, "period"), period],
  [tt(locale, "stack"), project.tags.join(" / ") || "—"],
];
if (project.client.isClient) facts.push([tt(locale, "clientWork"), project.client.label ? text(project.client.label, locale) : "✓"]);
---

<Base
  locale={locale}
  title={`${title} — ${portfolio.profile.name}`}
  description={text(project.summary, locale)}
  alternates={portfolio.locales.map((l) => ({ locale: l, href: projectUrl(project, l, portfolio) }))}
  homeHref={home}
>
  <article>
    <header class="head">
      <a class="back" href={home}>← {tt(locale, "back")}</a>
      <p class="kicker">{pad(index + 1)} / {pad(ordered.length)}</p>
      <h1>{title}</h1>
      <p class="summary">{text(project.summary, locale)}</p>
      {
        (project.links.live || project.links.repo) && (
          <p class="actions">
            {project.links.live && (
              <a class="btn primary" href={project.links.live} rel="noopener">
                {tt(locale, "live")} ↗
              </a>
            )}
            {project.links.repo && (
              <a class="btn" href={project.links.repo} rel="noopener">
                {tt(locale, "source")} ↗
              </a>
            )}
          </p>
        )
      }
    </header>

    {
      (desktop || mobile) && (
        <div class="scene">
          <div class:list={["screens", { "with-phone": desktop && mobile }]}>
            {desktop && (
              <figure class="screen">
                <img src={`/${desktop.src}`} alt={text(desktop.alt, locale)} width="1440" height="900" />
              </figure>
            )}
            {mobile && (
              <figure class="screen phone">
                <img src={`/${mobile.src}`} alt={text(mobile.alt, locale)} width="390" height="844" />
              </figure>
            )}
          </div>
        </div>
      )
    }

    <div class="body">
      <aside class="log" aria-labelledby="log-title">
        <h2 id="log-title" class="kicker">{tt(locale, "facts")}</h2>
        <dl>
          {
            facts.map(([k, v]) => (
              <div>
                <dt>{k}</dt>
                <dd>{v}</dd>
              </div>
            ))
          }
        </dl>
      </aside>
      <div class="description" set:html={renderMarkdown(text(project.description, locale))} />
    </div>

    {
      next && (
        <a class="next" href={projectUrl(next, locale, portfolio)}>
          {nextShot && <img src={`/${nextShot.src}`} alt="" loading="lazy" width="1440" height="900" />}
          <span class="next-text">
            <span class="kicker">{tt(locale, "next")}</span>
            <span class="next-title">{text(next.title, locale)} →</span>
          </span>
        </a>
      )
    }
  </article>
</Base>

<style>
  .head {
    display: grid;
    justify-items: center;
    gap: 14px;
    padding: 130px var(--pad) 64px;
    text-align: center;
  }
  .back {
    color: var(--muted);
    font-size: 14px;
    text-decoration: none;
  }
  .back:hover {
    color: var(--cyan);
  }
  h1 {
    margin: 0;
    background: linear-gradient(180deg, #fff 30%, #9fdcff);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-size: clamp(44px, 8vw, 120px);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.04em;
    overflow-wrap: anywhere;
  }
  .summary {
    max-width: 52ch;
    margin: 0;
    color: #c5cde3;
    font-size: clamp(17px, 1.8vw, 21px);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin: 10px 0 0;
  }
  .btn {
    padding: 11px 20px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-weight: 600;
    text-decoration: none;
  }
  .btn.primary {
    border-color: var(--cyan);
    background: var(--cyan);
    color: var(--bg);
  }
  .btn:hover {
    box-shadow: 0 0 24px rgb(110 243 255 / 0.4);
  }

  /* Screens arrive tilted in perspective and settle flat as they scroll into view. */
  .scene {
    padding: 0 var(--pad);
    perspective: 1400px;
  }
  .screens {
    display: grid;
    gap: clamp(10px, 2vw, 24px);
    max-width: 1240px;
    margin: 0 auto;
  }
  /* The phone column is sized so its height matches the desktop shot (16:10 vs 390:844). */
  .screens.with-phone {
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.3fr);
  }
  @supports (animation-timeline: view()) {
    :global(.fly) .screens {
      animation: settle linear both;
      animation-timeline: view();
      animation-range: entry 0% cover 45%;
    }
  }
  @keyframes settle {
    from {
      transform: rotateX(28deg) translateZ(-200px);
      opacity: 0.3;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }
  .screen {
    position: relative;
    min-height: 0;
    margin: 0;
    overflow: hidden;
    border: 1px solid rgb(110 243 255 / 0.25);
    border-radius: 14px;
    background: #0b0d1a;
    box-shadow: 0 40px 120px -30px rgb(110 243 255 / 0.3);
  }
  .screen img {
    width: 100%;
    height: auto;
  }
  .phone {
    border-radius: 22px;
  }
  .screens.with-phone .phone img {
    position: absolute;
    inset: 0;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .screens:not(.with-phone) .phone {
    max-width: 320px;
    margin-inline: auto;
  }

  .body {
    display: grid;
    grid-template-columns: minmax(240px, 320px) minmax(0, 1fr);
    gap: 48px;
    max-width: 1240px;
    margin: 0 auto;
    padding: 88px var(--pad) 0;
  }
  .log dl {
    display: grid;
    gap: 14px;
    margin: 16px 0 0;
  }
  .log dt {
    color: var(--muted);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .log dd {
    margin: 2px 0 0;
  }
  .description {
    max-width: 66ch;
    color: #c5cde3;
    font-size: 17px;
    line-height: 1.75;
  }
  .description > :global(:first-child) {
    margin-top: 0;
  }
  .description :global(h2),
  .description :global(h3) {
    color: var(--text);
    letter-spacing: -0.02em;
  }
  .description :global(a) {
    color: var(--cyan);
  }

  .next {
    position: relative;
    display: grid;
    place-items: center;
    height: 60vh;
    min-height: 320px;
    margin-top: 120px;
    overflow: hidden;
    text-decoration: none;
  }
  .next img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    opacity: 0.25;
    filter: blur(6px) saturate(1.4);
    transform: scale(1.1);
    transition:
      transform 0.8s,
      opacity 0.8s,
      filter 0.8s;
  }
  .next::after {
    position: absolute;
    inset: 0;
    content: "";
    background: radial-gradient(ellipse at center, transparent 20%, var(--bg) 75%);
  }
  .next:hover img {
    opacity: 0.45;
    filter: blur(0) saturate(1.2);
    transform: scale(1.02);
  }
  .next-text {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: 10px;
    text-align: center;
  }
  .next-title {
    font-size: clamp(34px, 6vw, 88px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  @media (max-width: 900px) {
    .body {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 600px) {
    .screens.with-phone {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.34fr);
    }
    .screen {
      border-radius: 8px;
    }
    .phone {
      border-radius: 12px;
    }
  }
</style>
