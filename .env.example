# Netlify personal access token: https://app.netlify.com/user/applications#personal-access-tokens
# Read access for discovery; `japs publish` also creates and deploys your portfolio site.
NETLIFY_TOKEN=

# GitHub fine-grained token, read-only: Metadata + Contents
# https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=

# LLM for `japs analyze` (ADR 0006). Any OpenAI-compatible provider:
# openai (default) | gemini | groq | openrouter | ollama
JAPS_LLM_PROVIDER=openai
# Optional for openai (default gpt-5-mini), required for the others
JAPS_LLM_MODEL=
# Key of the chosen provider (ollama needs none)
OPENAI_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# Custom OpenAI-compatible endpoint and key (override the preset)
# JAPS_LLM_BASE_URL=
# JAPS_LLM_API_KEY=
