{
  "name": "japs",
  "private": true,
  "description": "JAPS — Just Another Portfolio Site",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
