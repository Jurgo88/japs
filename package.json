{
  "name": "japs",
  "private": true,
  "description": "JAPS — Just Another Portfolio Site",
  "type": "module",
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --parallel typecheck",
    "japs": "pnpm --filter @japs/cli start",
    "dev": "pnpm --filter @japs/theme-default dev",
    "theme:build": "pnpm --filter @japs/theme-default build",
    "editor": "pnpm --filter @japs/dashboard build && pnpm japs edit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
